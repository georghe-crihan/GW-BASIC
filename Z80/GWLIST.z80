;;; EXTENDED LIST ;;;


;;; DELETE ;;;


;;; LLIST ;;;

	PUBLIC LLIST
LLIST:
	PUSH HL
	LD HL, OFFSET 0 -1
	LD (PTRFIL), HL		; FDB pointer = LPT Pseudo FDB
	POP HL
	PUBLIC LIST
LIST:
	POP BC		; GET RID OF NEWSTT RETURN ADDR
	CALL SCNLIN		; SCAN LINE RANGE
	PUSH BC		; SAVE POINTER TO 1ST LINE
	CALL PROCHK		; DONT EVEN LIST LINE #
	LD HL, (TEMP)		; Get Text pointer
	DEC HL
	CALL CHRGTR
	JR Z, LIST4		; Brif LIST to CRT.
	CALL SYNCHR
	DB 44D
;  else must be ,"dev:"
	CALL NAMSCN		; Crack File spec.
	EXTERN NAMSCN:NEAR
	EXTERN NULOPM:NEAR
	LD A, LOW OFFSET MD_SQO		; OPEN FILE 0 FOR OUTPUT
	CALL NULOPM
LIST4:
	LD HL, 65535		; DONT ALLOW ^C TO CHANGE
	LD (CURLIN), HL		; CONTINUE PARAMETERS
	POP HL		; GET POINTER TO LINE
	POP DE		; GET MAX LINE # OFF STACK
	LD C, (HL)		; [B,C]=THE LINK POINTING TO THE NEXT LINE
	INC HL
	LD B, (HL)
	INC HL
	LD A, B		; SEE IF END OF CHAIN
	OR C
	JP Z, READY
; LAST LINE, STOP.  
	EXTERN POLKEY:NEAR
	CALL POLKEY		; check CTL C, queue typeahead
	PUSH BC		; SAVE LINK
	LD C, (HL)		; PUSH THE LINE #
	INC HL
	LD B, (HL)
	INC HL
	PUSH BC
	EX (SP), HL		; XTHL
; GET LINE # INTO [H,L]
	EX DE, HL		; GET MAX LINE IN [H,L]
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E		; PAST LAST LINE IN RANGE?
	POP BC		; TEXT POINTER TO [B,C]
	JP C, STPRDY
; IF PAST, THEN DONE LISTING.
	EX (SP), HL		; XTHL
; SAVE MAX ON BOTTOM OF STACK
	PUSH HL		; SAVE LINK ON TOP
	PUSH BC		; SAVE TEXT POINTER BACK
	EX DE, HL		; GET LINE # IN [H,L]
	LD (DOT), HL		; SAVE FOR LATER EDIT OR LIST
; AND WE WANT [H,L] ON THE STACK
	CALL LINPRT		; PRINT AS INTEGER WITHOUT LEADING SPACE
	POP HL
	LD A, (HL)		; GET BYTE FROM LINE
	CP 9		; IS IT A TAB?
	JR Z, NOSPAL		; THEN DONT PRINT SPACE
	LD A, LOW " "
	CALL OUTDO		; PRINT A SPACE AFTER THE LINE #
NOSPAL:
	CALL BUFLIN		; UNPACK THE LINE INTO BUF
	LD HL, (BUF)		; POINT AT THE START OF THE UNPACKED CHARACTERS
	CALL LISPRT		; PRINT THE LINE
	CALL CRDO		; PRINT CRLF
	JR LIST4		; GO BACK FOR NEXT LINE
	PUBLIC LISPRT
LISPRT:
	LD A, (HL)
	CP 10
	CALL Z, LISEOL
; erase to end-of-line after LF and 0
	OR A
	CALL Z, LISEOL
	RET Z
; IF =0 THEN END OF LINE
	EXTERN OUTCH1:NEAR
	CALL OUTCH1		; OUTPUT CHAR AND CHECK FOR LF
	INC HL		; INCR POINTER
	JR LISPRT		; PRINT NEXT CHAR
; Routine to output sequence to Clear to end of line if current device
;  is Standard Output (CRT)
;  Exit - All registers preserved.
; 
LISEOL:
	PUSH AF		;  PUSH PSW
	CALL ISFLIO
	JP NZ, LISELX
; return if listing to a file
; CSEG DATASG (public)
	EXTERN F_EDIT:WORD
	LD A, (F_EDIT)		; Save current edit mode
	PUSH AF		;  PUSH PSW
	LD A, LOW 5		; 05=erase to end-of-line for non-IBMLIK
	LD (F_EDIT), A		; Enter edit mode(05 is control function)
	CALL OUTDO		; output 05 to current device
	POP AF		;  POP PSW
	LD (F_EDIT), A		; Restore edit mode
LISELX:
	POP AF		;  POP PSW
	RET
	PUBLIC BUFLIN
BUFLIN:
	LD BC, (BUF)		; GET START OF TEXT BUFFER
	LD D, LOW OFFSET BUFLEN		; GET ITS LENGTH INTO [D]
	XOR A		; SET MODE OF DECRUNCH
	LD (DORES), A		; BIT0 IS QUOTE BIT1 IS DATA BIT2 IS REM
	XOR A		; SET ON SPECIAL CHAR FOR SPACE INSERTION
	LD (TEMPA), A
	CALL PROCHK		; ONLY PROCEED IF OK
	JR PLOOP2		; START HERE
PLOOP:
	INC BC		; INCREMENT DEPOSIT PTR.
	INC HL		; ADVANCE TEXT PTR
	DEC D		; BUMP DOWN COUNT
	RET Z
; IF BUFFER FULL, RETURN
	PUBLIC PLOOP2
PLOOP2:
	LD A, (HL)		; GET CHAR FROM BUF
	OR A		; SET CC'S
	LD IXH, B
	LD IXL, C
	LD (IX), A		; SAVE THIS CHAR
	RET Z
; IF END OF SOURCE BUFFER, ALL DONE.
	CP OCTCON		; IS IT SMALLER THAN SMALLEST EMBEDDED CONSTANT?
	JR C, NTEMBL		; YES, DONT TREAT AS ONE
	CP DBLCN1		; IS IT EMBEDED CONSTANT?
	LD E, A		; SAVE CHAR IN [E]
	JR C, PRTVAR		; PRINT LEADING SPACE IF NESC.
	CP 34		; IS IT A QUOTATION
	JR NZ, BFCHKC		; IF NOT CHECK FOR COLON
	LD A, (DORES)		; COMPLEMENT THE QUOTE BIT
	XOR 1D
	LD (DORES), A
	LD A, LOW 34		; RESTORE THE CHARACTER
BFCHKC:
	CP ":"		; IS IT A COLON ENDING DATA?
	JR NZ, NTEMBL
	LD A, (DORES)		; DON'T END IF IN QUOTE
	RRCA
	JR C, QTCOLN
	RLCA
	AND LOW 253		; TURN OFF BIT1 (DATA BIT)
	LD (DORES), A
QTCOLN:
	LD A, LOW ":"
NTEMBL:
	OR A		; SET CC'S
	JP M, PLOOPR
; RESERVED WORD OF SOME KIND
	LD E, A		; SAVE CHAR IN [E]
	CP "."		; DOT IS PART OF VAR NAME
	JR Z, PRTVAR
	CALL TSTANM		; IS CHAR ALPHANUMERIC
	JR NC, PRTVAR		; ALPHANUMERIC
	XOR A		; MAKE SPECIAL
	JR PLOOPH
PRTVAR:
	LD A, (TEMPA)		; WHAT DID WE DO LAST?
	OR A		; SET CONDITION CODES
	JR Z, PLOOPG		; SPECIAL, NEVER INSERT SPACE
	INC A		; IN RESERVED WORD?
	JR NZ, PLOOPG		; NO
	LD A, LOW " "		; PUT OUT SPACE BEFORE RESWORD
	LD IXH, B
	LD IXL, C
	LD (IX), A		; STORE IN BUFFER
	INC BC		; INCRMENT POINTER INTO BUFFER
	DEC D		; SPACE LEFT?
	RET Z
; NO, DONE
PLOOPG:
	LD A, LOW 1		; STORE FLAG SAYING IN VAR
PLOOPH:
	LD (TEMPA), A
	LD A, E		; GET BACK CHAR WE HAD
	CP OCTCON		; IS IT SMALLER THAN SMALLEST EMBEDDED CONSTANT?
	JR C, PLOOPZ		; YES, DONT TREAT AS ONE
	CP DBLCN1		; IS IT EMBEDED CONSTANT?
	JP C, NUMLIN
; YES, UNPACK IT
PLOOPZ:
	LD IXH, B
	LD IXL, C
	LD (IX), A		; MAKE SURE BYTE STORED AFTER SPACE
	JP PLOOP		; STORE IN BUFFER
PLOOPR:
	LD A, (DORES)		; SEEWHAT OUR UNCRUNCH MODE IS
	RRCA		; THE LSB IS THE QUOTE BIT
	JR C, GPLOOP
	RRCA		; GET THE REM BIT
	RRCA		; AND SEE IF SET
	JR NC, CHKDRS		; IF NOT JUST CHECK DATA BIT
	LD A, (HL)		; MUST SEE IF ITS SNGQTK
	CP SNGQTK		; AND PRECEDED BY ":REM"
	PUSH HL
	PUSH BC		; SAVE BUFFER POINTER
	LD HL, OFFSET NOSNGQ		; PLACE TO RETURN ON FAILURE
	PUSH HL
	RET NZ
	DEC BC
	LD IYH, B
	LD IYL, C
	LD A, (IY)
	CP "M"
	RET NZ
	DEC BC
	LD IYH, B
	LD IYL, C
	LD A, (IY)
	CP "E"
	RET NZ
	DEC BC
	LD IYH, B
	LD IYL, C
	LD A, (IY)
	CP "R"
	RET NZ
	DEC BC
	LD IYH, B
	LD IYL, C
	LD A, (IY)
	CP ":"
	RET NZ
	POP AF		; GET RID OF RETURN ON FAIL ADDRESS
	POP AF		; GET RID OF BAD BUFFER POINTER
	POP HL		; GET BACK POINTER INTO LINE
	INC D		; UPDATE CHAR COUNT
	INC D
	INC D
	INC D
	JR RESEXP
NOSNGQ:
	POP BC		; GET BACK THE BUFFERPOINTER
	POP HL		; GET BACK SOURCE LINE POINTER
	LD A, (HL)		; GET BACK THE CHARACTER
GPLOOP:
	JP PLOOP
DATSET:
	LD A, (DORES)		; BIT INDICATING INSIDE DATA
	OR 2D		; IS BIT1
SETDRS:
	LD (DORES), A
	XOR A
	RET
REMSET:
	LD A, (DORES)
	OR 4D
	JR SETDRS
CHKDRS:
	RLCA		; GET DATA BIT INTO CARRY
	JR C, GPLOOP
	LD A, (HL)		; GET BACK THE CHARACTER
	CP $DATA		; NEED TO SET A BIT
	CALL Z, DATSET
	CP $REM
	CALL Z, REMSET
RESEXP:
	LD A, (HL)
	INC A		; SET ZERO IF FN TOKEN
	LD A, (HL)		; GET CHAR BACK
	JR NZ, NTFNTK		; NOT FUNCTION JUST TREAT NORMALLY
	INC HL		; BUMP POINTER
	LD A, (HL)		; GET CHAR
	AND LOW 127		; TURN OFF HIGH BIT
NTFNTK:
	INC HL		; ADVANCE TO POINT AFTER
NTQTTK:
	CP $ELSE		; ELSE?
	JR NZ, NOTELS
	DEC BC
	INC D
NOTELS:
	CP $WHILE		; MIGHT HAVE AN EXTRA "+" IN WHILE FORMULA
	JR NZ, BFNTWH		; SO SKIP OVER IT IF ITS THERE
	LD A, (HL)		; GET CHARACTER TO SEE IF ITS PLUSTK
	INC HL		; ASSUME IS PLUSTK
	CP PLUSTK		; MIGHT NOT BE PLUS IF BINARY SAVED IN
	LD A, LOW OFFSET $WHILE		; RESTORE TOKEN VALUE
	JR Z, BFNTWH		; VERSION OF BASIC BEFORE CRUNCH CHANGED
	DEC HL		; MOVE POINTER BACK
BFNTWH:
	PUSH HL		; SAVE TEXT PTR.
	PUSH BC		; SAVE DEPOSIT PTR.
	PUSH DE		; SAVE CHAR COUNT.
	EXTERN LISTX:NEAR
	CALL LISTX		; Handle extended reserved words.
	LD HL, OFFSET RESLST -1		; GET PTR TO START OF RESERVED WORD LIST
	LD B, A		; SAVE THIS CHAR IN [B]
	LD C, LOW OFFSET "A" -1		; INIT LEADING CHAR VALUE
RESSR3:
	INC C		; BUMP LEADING CHAR VALUE.
RESSR1:
	INC HL		; BUMP POINTER INTO RESLST
RESSRC:
	LD D, H		; SAVE PTR TO START OF THIS RESWRD
	LD E, L
RESSR2:
; FETCH FROM CODE SEGMENT
	LD A, (HL)		; GET CHAR FROM RESLST
	OR A		; SET CC'S
	JR Z, RESSR3		; IF END OF THIS CHARS TABLE, GO BACK & BUMP C
	INC HL
; BUMP SOURCE PTR
	JP P, RESSR2
; IF NOT END OF THIS RESWRD, THEN KEEP LOOKING
; FETCH FROM CODE SEGMENT
	LD A, (HL)		; GET PTR TO RESERVED WORD VALUE
	CP B		; SAME AS THE ONE WE SEARCH FOR?
	JR NZ, RESSR1		; NO, KEEP LOOKING.
	EX DE, HL		; SAVE FOUND PTR IN [H,L]
	CP $USR		; USR FUNCTION TOKEN?
	JR Z, NOISPA		; DONT INSERT SPACE
	CP $FN		; IS IT FUNCTION TOKEN?
NOISPA:
	LD A, C		; GET LEADING CHAR
	POP DE		; RESTORE LINE CHAR COUNT
	POP BC		; RESTORE DEPOSIT PTR
	LD E, A		; SAVE LEADING CHAR
	JR NZ, NTFNEX		; NOT "FN" EXPANSION
	LD A, (TEMPA)		; SET CC'S ON TEMPA
	OR A
	LD A, LOW 0		; CLEAR RESWRD FLAG - MARK AS SPECIAL
	LD (TEMPA), A		; SET FLAG
	JR MORLNZ		; DO EXPANSION
NTFNEX:
	CP "Z"+1		; WAS IT A SPECIAL CHAR?
	JR NZ, NTSPCH		; NON-SPECIAL CHAR
	XOR A		; SET NON-SPECIAL
	LD (TEMPA), A
	JR MORPUR		; PRINT IT
NTSPCH:
	LD A, (TEMPA)		; WHAT DID WE DO LAST?
	OR A		; SPECIAL?
	LD A, LOW 255		; FLAG IN RESERVED WORD
	LD (TEMPA), A		; CLEAR FLAG
MORLNZ:
	JR Z, MORLN0		; GET CHAR AND PROCEED
	LD A, LOW " "		; PUT SPACE IN BUFFER
	LD IXH, B
	LD IXL, C
	LD (IX), A
	INC BC
	DEC D		; ANY SPACE LEFT IN BUFFER
	JP Z, PPSWRT
; NO, RETURN
MORLN0:
	LD A, E
	JR MORLN1		; CONTINUE
MORPUR:
; FETCH FROM CODE SEGMENT
	LD A, (HL)		; GET BYTE FROM RESWRD
	INC HL		; BUMP POINTER
MORLNP:
	LD E, A		; SAVE CHAR
MORLN1:
	AND LOW 127		; AND OFF HIGH ORDER BIT FOR DISK & EDIT
	LD IXH, B
	LD IXL, C
	LD (IX), A		; STORE THIS CHAR
	INC BC		; BUMP PTR
	DEC D		; BUMP DOWN REMAINING CHAR COUNT
	JP Z, PPSWRT
; IF END OF LINE, JUST RETURN
	OR E		; SET CC'S
	JP P, MORPUR
; END OF RESWRD?
	CP "("+128		; SPC( OR TAB( ?
	JR NZ, NTSPCT		; NO
	XOR A		; CLEAR FLAG
	LD (TEMPA), A		; TO INSERT SPACE AFTERWARDS
NTSPCT:
	POP HL		; RESTORE SOURCE PTR.
	JP PLOOP2		; GET NEXT CHAR FROM LINE
	PUBLIC TSTANM
TSTANM:
	CALL ISLET2		; LETTER?
	RET NC
; YES
	CP "0"		; DIGIT?
	RET C
; TOO SMALL
	CP "9"+1		; LAST DIGIT
	CCF		; MAKE CARRY RIGHT
	RET		; NO CARRY=DIGIT
NUMLIN:
	DEC HL		; MOVE POINTER BACK AS CHRGET INX'S
	CALL CHRGTR		; SCAN THE CONSTANT
	PUSH DE		; SAVE CHAR COUNT
	PUSH BC		; SAVE DEPOSIT PTR
	PUSH AF		; SAVE CONSTANT TYPE.
	CALL CONFC1		; MOVE CONSTANT INTO FAC
	POP AF		; RESTORE CONSTANT TYPE
	LD BC, OFFSET CONLIN		; PUT RETURN ADDR ON STACK
	PUSH BC		; SAVE IT
	CP OCTCON		; OCTAL CONSTANT?
	JP Z, FOUTO
; PRINT IT
	CP HEXCON		; HEX CONSTANT?
	JP Z, FOUTH
; PRINT IN HEX
	LD HL, (CONLO)		; GET LINE # VALUE IF ONE.
	JP FOUT		; PRINT REMAINING POSSIBILITIES.
CONLIN:
	POP BC		; RESTORE DEPOSIT PTR.
	POP DE		; RESTORE CHAR COUNT
	LD A, (CONSAV)		; GET SAVED CONSTANT TOKEN
	LD E, LOW "O"		; ASSUME OCTAL CONSTANT
	CP OCTCON		; OCTAL CONSTANT?
	JR Z, SAVBAS		; YES, PRINT IT
	CP HEXCON		; HEX CONSTANT?
	LD E, LOW "H"		; ASSUME SO.
	JR NZ, NUMSLN		; NOT BASE CONSTANT
SAVBAS:
	LD A, LOW "&"		; PRINT LEADING BASE INDICATOR
	LD IXH, B
	LD IXL, C
	LD (IX), A		; SAVE IT
	INC BC		; BUMP PTR
	DEC D		; BUMP DOWN CHAR COUNT
	RET Z
; RETURN IF END OF BUFFER
	LD A, E		; GET BASE CHAR
	LD IXH, B
	LD IXL, C
	LD (IX), A		; SAVE IT
	INC BC		; BUMP PTR
	DEC D		; BUMP DOWN BASE COUNT
	RET Z
; END OF BUFFER, DONE
NUMSLN:
	LD A, (CONTYP)		; GET TYPE OF CONSTANT WE ARE
	CP 4		; IS IT SINGLE OR DOUBLE PREC?
	LD E, LOW 0		; NO, NEVER PRINT TRAILING TYPE INDICATOR
	JR C, TYPSET
	LD E, LOW "!"		; ASSUME SINGLE PREC.
	JR Z, TYPSET		; IS CONTYP=4, WAS SINGLE
	LD E, LOW "#"		; DOUBLE PREC INDICATOR
TYPSET:
	LD A, (HL)		; GET LEADING CHAR
	CP " "		; LEADING SPACE
	CALL Z, INXHRT
; GO BY IT
NUMSL2:
	LD A, (HL)		; GET CHAR FROM NUMBER BUFFER
	INC HL		; BUMP POINTER
	OR A		; SET CC'S
	JR Z, NUMDN		; IF ZERO, ALL DONE.
	LD IXH, B
	LD IXL, C
	LD (IX), A		; SAVE CHAR IN BUF.
	INC BC		; BUMP PTR
	DEC D		; SEE IF END OF BUFFER
	RET Z
; IF END OF BUFFER, RETURN
	LD A, (CONTYP)		; GET TYPE OF CONSTANT TO BE PRINTED
	CP 4		; TEST FOR SINGLE OR DOUBLE PRECISION
	JR C, NUMSL2		; NO, WAS INTEGER
	DEC BC
; PICK UP SAVED CHAR
	LD IYH, B
	LD IYL, C
	LD A, (IY)		; EASIER THAN PUSHING ON STACK
	INC BC
; RESTORE TO POINT WHERE IT SHOULD
	JR NZ, DBLSCN		; IF DOUBLE, DONT TEST FOR EMBEDED "."
	CP "."		; TEST FOR FRACTION
	JR Z, ZERE		; IF SINGLE & EMBEDED ., THEN DONT PRINT !
DBLSCN:
	CP "D"		; DOUBLE PREC. EXPONENT?
	JR Z, ZERE		; YES, MARK NO VALUE TYPE INDICATOR NESC.
	CP "E"		; SINGLE PREC. EXPONENT?
	JR NZ, NUMSL2		; NO, PROCEED
ZERE:
	LD E, LOW 0		; MARK NO PRINTING OF TYPE INDICATOR
	JR NUMSL2		; KEEP MOVING NUMBER CHARS INTO BUF
NUMDN:
	LD A, E		; GET FLAG TO INDICATE WHETHER TO INSERT
	OR A		; A "D" AFTER DOUBLE PREC. #
	JR Z, NOD		; NO, DONT INSERT IT
	LD IXH, B
	LD IXL, C
	LD (IX), A		; SAVE IN BUFFER
	INC BC		; BUMP POINTER
	DEC D		; DECRMENT COUNT OF CHARS LEFT IN BUFFER
	RET Z
; =0, MUST TRUNCATE LIST OF THIS LINE.
NOD:
	LD HL, (CONTXT)		; GET BACK TEXT POINTER AFTER CONSTANT
	JP PLOOP2		; GET NEXT CHAR
; 
;  THE FOLLOWING CODE IS FOR THE DELETE RANGE
;  COMMAND. BEFORE THE LINES ARE DELETED, 'OK'
;  IS TYPED.
; 
	PUBLIC DELETE
DELETE:
	CALL SCNLIN		; SCAN LINE RANGE
	PUSH BC
	CALL DEPTR		; CHANGE POINTERS BACK TO NUMBERS
	POP BC
	POP DE		; POP MAX LINE OFF STACK
	PUSH BC		; SAVE POINTER TO START OF DELETION
; FOR USE BY CHEAD AFTER FINI
	PUSH BC		; SAVE POINTER TO START OF 1ST LINE
	CALL FNDLIN		; FIND THE LAST LINE
	JR NC, FCERRG		; MUST HAVE A MATCH ON THE UPPER BOUND
	LD D, H		; [D,E]=POINTER AT THE START OF THE LINE
	LD E, L		; BEYOND THE LAST LINE IN THE RANGE
	EX (SP), HL		; XTHL
; SAVE THE POINTER TO THE NEXT LINE
	PUSH HL		; SAVE THE POINTER TO THE START OF
; THE FIRST LINE IN THE RANGE
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E		; MAKE SURE THE START COMES BEFORE THE END
FCERRG:
	JP NC, FCERR
; IF NOT, "ILLEGAL FUNCTION CALL"
; DELETE must now be at EOL
	EXTERN EOSCHK:NEAR
	LD HL, (TEMP)		; Get text pointer
	CALL EOSCHK		; Check for end of statement
	LD HL, OFFSET REDDY		; PRINT "OK" PREMATURELY
	CALL STROUT
	POP BC		; GET POINTER TO FIRST IN [B,C]
	LD HL, OFFSET FINI		; GO BACK TO FINI WHEN DONE
	EX (SP), HL		; XTHL
; [H,L]=POINTER TO THE NEXT LINE
;  ERASE A LINE FROM MEMORY
;  [B,C]=START OF LINE BEING DELETED
;  [H,L]=START OF NEXT LINE
; 
	PUBLIC DEL
DEL:
	EX DE, HL		; [D,E] NOW HAVE THE POINTER TO THE LINE
; BEYOND THIS ONE
	LD HL, (VARTAB)		; COMPACTIFYING TO VARTAB
MLOOP:
	LD IYH, D
	LD IYL, E
	LD A, (IY)
	LD IXH, B
	LD IXL, C
	LD (IX), A		; SHOVING DOWN TO ELIMINATE A LINE
	INC BC
	INC DE
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E		; DONE COMPACTIFYING?
	JR NZ, MLOOP		; NO
	PUSH HL
	POP BC
	
; Clear SCALARS and ARRAYS incase we are replacing line which may force
;  garbage collection in BLTU
	LD (VARTAB), HL
	LD (ARYTAB), HL
	LD (STREND), HL
	RET
