;  [ This translation created 10-Feb-83 by Version 4.3 ]
	.radix 8
;  To be safe
; CSEG CODESG (public)
; Assuming segment CS:CSEG
	include OEM.H

;;;;;;;;;;;;;;;;;
;; NEXT86 CODE ;;
;;;;;;;;;;;;;;;;;

	.radix 8
; ****************************************************************
; 
;  A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
; 
;  LOW ADDRESS
;        TOKEN ($FOR IN HIGH BYTE)  1 BYTES
;        A POINTER TO THE LOOP VARIABLE  2 BYTES
;        UNDER ANSI & LENGTH=2, TWO BYTES GIVING TEXT POINTER OF  
;        MATCHING "NEXT"
;        A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
;        UNDER LENGTH=2, A BYTE MINUS FOR INTEGER AND 
;        POSITIVE FOR FLOATING "FOR'S"
;        THE STEP 4 BYTES
;        THE UPPER VALUE 4 BYTES
;        THE LINE # OF THE "FOR" STATEMENT 2 BYTES
;        A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
;  HIGH ADDRESS
; 
;  TOTAL 16-19 BYTES
; 
; *****************************************************************
	EXTERN CHRGTR:NEAR
	EXTERN DCOMPR:NEAR
	EXTERN FADDS:NEAR
	EXTERN FCOMP:NEAR
	EXTERN FNDFOR:NEAR
	EXTERN IADD:NEAR
	EXTERN ICMPA:NEAR
	EXTERN MOVFM:NEAR
	EXTERN MOVMF:NEAR
	EXTERN MOVRM:NEAR
	EXTERN NEWSTT:NEAR
	EXTERN NFERR:NEAR
	EXTERN NXTCON:NEAR
	EXTERN OVERR:NEAR
	EXTERN PTRGET:NEAR
	PUBLIC NEXT
	PUBLIC NEXTS
; CSEG DATASG (public)
; Assuming segment DS:DSEG
	EXTERN NXTFLG:WORD
	EXTERN FVALSV:WORD
	EXTERN NXTTXT:WORD
; CSEG DATASG (public)
	EXTERN FACLO:WORD
	EXTERN SAVSTK:WORD
	EXTERN TEMP:WORD
	EXTERN VALTYP:WORD
	EXTERN CURLIN:WORD
NF1:
	JP NFERR
NEXT:
