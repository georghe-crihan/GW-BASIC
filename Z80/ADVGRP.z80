;  [ This translation created 10-Feb-83 by Version 4.3 ]
	.radix 8
;  To be safe
; CSEG CODESG (public)
; Assuming segment CS:CSEG
	include OEM.H

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ADVGRP - ADVANCED GENERALIZED GRAPHICS STUFF ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

	.radix 10
; Number of graphics planes.  Used to
; calculate the array size in PUT/GET.
	PWR2PX=(MELCO OR TETRA OR MCI OR SIRIUS)-1
; TRUE IF BITS/PIXEL IS ALWAYS POWER
; OF TWO. SAVES MULTIPLICATION.
	TETRA=0
	ZENITH=0
	MCI=0
	MELCO=0
; Mitsubishi Electronics Co.
	SIRIUS=0
	HAL=0
	HALL3=0
	HALL4=0
	ALPCPM=0
	PC8A=0
	MODEL3=0
	TSHIBA=0
	KANJSW=PC8A OR (TSHIBA AND (TRUROM-1))
; PUT @(x,y),KANJI(c) function,on,off
; 
;  MACHINE DEPENDENT SWITCHES
; 
	TILE=0
	WINDOW=0
	LINEST=0
	VIEW=0
	VIEW=MODEL3 OR PC8A OR TRSER2
;  SWITCH FOR GRAPHICS VIEW
	TILE=MODEL3 OR PC8A OR TRSER2 OR HALL4
	WINDOW=PC8A
	QUEUE=MODEL3 OR PC8A OR TRSER2 OR GW
	LINEST=MODEL3 OR PC8A OR TRSER2
; CSEG DATASG (public)
; Assuming segment DS:DSEG
	EXTERN QUELEN:WORD
	EXTERN PSNLEN:WORD
	EXTERN QUEINP:WORD
	EXTERN QUEOUT:WORD
;  MACHINE DEPENDENT GRAPHICS ROUTINES:
	EXTERN SETATR:NEAR
	EXTERN SETC:NEAR
	EXTERN MAPXYC:NEAR
	EXTERN SCALXY:NEAR
	EXTERN FETCHC:NEAR
	EXTERN STOREC:NEAR
	EXTERN UPC:NEAR
	EXTERN DOWNC:NEAR
	EXTERN LEFTC:NEAR
	EXTERN PGINIT:NEAR
	EXTERN PIXSIZ:NEAR
	EXTERN SCANL:NEAR
	EXTERN SCANR:NEAR
	EXTERN PNTINI:NEAR
	EXTERN TUPC:NEAR
	EXTERN TDOWNC:NEAR
	EXTERN NREAD:NEAR
	EXTERN NWRITE:NEAR
	EXTERN GTASPC:NEAR
;  STUFF IN GENGRP.MAC:
	EXTERN DOGRPH:NEAR
	EXTERN ATRSCN:NEAR
	EXTERN SCAN1:NEAR
	EXTERN SCAND:NEAR
; CSEG DATASG (public)
	EXTERN GRPACX:WORD
	EXTERN GRPACY:WORD
	EXTERN GXPOS:WORD
	EXTERN GYPOS:WORD
	EXTERN ATRBYT:WORD
;  OTHER STUFF:
	EXTERN CHRGTR:NEAR
	EXTERN GETBYT:NEAR
	EXTERN GETIN2:NEAR
	EXTERN GETYPR:NEAR
	EXTERN SYNCHR:NEAR
	EXTERN UMULT:NEAR
	EXTERN MINUTK:NEAR
	EXTERN FDIV:NEAR
	EXTERN FCERR:NEAR
	EXTERN MAKINT:NEAR
	EXTERN POLKEY:NEAR
	CKCNTC equ POLKEY
	MKINTC equ MAKINT
	EXTERN DCOMPR:NEAR
; 
;  MACRO DEFINITIONS
; 
; Stripped useless macro: MOVRI
HLFDE MACRO 
	SRL D
	RR E		; ;SHR DX,1
ENDM
HLFHL MACRO 
	SRL H
	RR L		; ;SHR BX,1
ENDM
NEGDE MACRO 
	EX AF, AF'
	XOR A
	SUB E
	LD E, A
	SBC A, A
	SUB D
	LD D, A
	EX AF, AF'
ENDM
NEGHL MACRO 
	EX AF, AF'
	XOR A
	SUB L
	LD L, A
	SBC A, A
	SUB H
	LD H, A
	EX AF, AF'
ENDM

;;; PAINT - Fill an area with color ;;;

; 
;        PAINT - FILL AN AREA WITH COLOR
; 
;  SYNTAX: PAINT (X,Y), FILLC, BORDC]]
; 
	PUBLIC PAINT
	EXTERN PNTINI:NEAR
	EXTERN SCANL:NEAR
	EXTERN SCANR:NEAR
	EXTERN TUPC:NEAR
	EXTERN TDOWNC:NEAR
; CSEG DATASG (public)
	EXTERN PDIREC:WORD
	EXTERN CSAVEA:WORD
	EXTERN CSAVEM:WORD
	EXTERN MOVCNT:WORD
	EXTERN SKPCNT:WORD
	EXTERN LFPROG:WORD
	EXTERN RTPROG:WORD
PAINT:
; GET (X,Y) OF START
	CALL INTQUE		; INIT QUE
	CALL SCAN1
	PUSH BC		; SAVE COORDS OF START
	PUSH DE
	CALL ATRSCN		; SET FILL ATTRIBUTE AS CURRENT
	LD A, (ATRBYT)		; DEFAULT BORDER COLOR IS SAME AS FILL
	LD E, A		; DEFAULT ATTRIBUTE TO [E] LIKE GETBYT
	DEC HL
	CALL CHRGTR
	JR Z, GOTBRD		; NOTHING THERE - USE DEFAULT
	CALL SYNCHR
	DB 44D
; MAKE SURE OF COMMA
	CALL GETBYT		; GET BORDER COLOR ARGUMENT
GOTBRD:
	LD A, E		; BORDER ATTRIBUTE TO A
	CALL PNTINI		; INIT PAINT STUFF & CHECK BORDER ATTRIB
	JP C, FCERR
	POP DE		; GET BACK START COORDS
	POP BC
	PUSH HL		; SAVE TXTPTR UNTIL DONE
	CALL CHKRNG		; MAKE SURE POINT IS ON SCREEN
	CALL MAPXYC
	LD DE, 1		; ENTRY COUNT IS ONE (SKIP NO BORDER)
	CALL SCANR1		; SCAN RIGHT FROM INITIAL POSITION
	JR Z, POPTRT		; STARTED ON BORDER - GET TXTPTR & QUIT
	PUSH HL		; SAVE NO. OF POINTED PAINTED TO RIGHT
	CALL SCANL1		; NOW SCAN LEFT FROM INITIAL POS.
	POP DE		; GET RIGHT SCAN COUNT.
	ADD HL, DE		; ADD TO LEFT SCAN COUNT
	EX DE, HL		; COUNT TO [DE]
	LD A, LOW 64		; MAKE ENTRY FOR GOING DOWN
	CALL ENTST1
	LD B, LOW 192		; CAUSE PAINTING UP
	JR STPAIN		; START PAINTING UPWARD
POPTRT:
	POP HL		; GET BACK TEXTPTR
	RET
; 
;  MAIN PAINT LOOP
; 
PNTLOP:
	CALL CKCNTC		; CHECK FOR CTRL-C ABORT
PNTLP1:
	CALL GETQ		; GET ONE ENTRY FROM QUEUE
	LD A, C		; NOW GO SET UP CURRENT LOCATION
	CALL STOREC
STPAIN:
	LD A, B		; GET DIRECTION
	LD (PDIREC), A
	RLA		; SEE WHETHER TO GO UP, DOWN, OR QUIT
	JR Z, POPTRT		; IF ZERO, ALL DONE.
	PUSH DE		; SAVE SKPCNT IN CASE TUP&TDOWN DON'T
	JR NC, PDOWN		; IF POSITIVE, GO DOWN FIRST
	CALL TUPC		; MOVE UP BEFORE SCANNING
	JR PDOWN2
PDOWN:
	CALL TDOWNC		; SEE IF AT BOTTOM & MOVE DOWN IF NOT
PDOWN2:
	POP DE		; GET SKPCNT BACK
	JR C, PNTLP1		; OFF SCREEN - GET NEXT ENTRY
PNTLP2:
; SCAN RIGHT & SKIP UP TO SKPCNT BORDER
	CALL SCANR1
	JP Z, PNTLP1
; IF NO POINTS PAINTED, GET NEXT ENTRY
	CALL SCANL1		; NOW SCAN LEFT FROM START POINT
	LD E, L		; [DE] = LEFT MOVCNT
	LD D, H
	OR A		; SEE IF LINE WAS ALREADY PAINTED
	JR Z, PNTLP3		; IT WAS - DON'T MAKE OVERHANG ENTRY
	DEC HL		; IF LMVCNT.GT.1, NEED TO MAKE ENTRY
	DEC HL		; IN OPPOSITE DIRECTION FOR OVERHANG.
	LD A, H
	RLA		; SEE IF [HL] WAS .GT. 1
	JR C, PNTLP3
	LD A, (PDIREC)
	CPL
	PUSH AF		;  PUSH PSW
	CALL FETCHC		; GET CURRENT POINT ADDRESS
	LD C, A		; C=CMASK
	POP AF		;  POP PSW
; GET BACK DIRECTION AND INDEX
	LD B, A
	CALL PUTQ
PNTLP3:
	LD HL, (MOVCNT)		; GET COUNT PAINTED DURING RIGHT SCAN
	ADD HL, DE		; ADD TO LEFT MOVCNT
	EX DE, HL		; ENTRY COUNT TO [DE]
	CALL ENTSLR		; GO MAKE ENTRY.
	LD HL, (CSAVEA)		; SET CURRENT LOCATION BACK TO END
	LD A, (CSAVEM)		; OF RIGHT SCAN.
	CALL STOREC
PNTLP4:
	LD HL, (SKPCNT)		; CALC SKPCNT - MOVCNT TO SEE IF
	LD DE, (MOVCNT)		; ANY MORE BORDER TO SKIP
	SBC HL, DE
	JR Z, GOPLOP		; NO MORE - END OF THIS SCAN
	JR C, PNTLP6		; RIGHT OVERHANG - SEE IF ENTRY NEEDED
	EX DE, HL		; SKIP COUNT TO [DE] FOR SCANR
	CALL SCANR1		; HERE IF NEED TO CONTINUE RIGHT SCAN
	JR Z, GOPLOP		; NO MORE POINTS.
	OR A		; SEE IF LINE ALREADY PAINTED
	JR Z, PNTLP4		; YES, DON'T ENTER ANYTHING
	EX DE, HL		; ENTRY COUNT TO [DE]
	LD HL, (CSAVEA)		; MAKE ENTRY AT LOCATION SAVED BY SCANR
	LD A, (CSAVEM)		; SO WE CAN ENTER A POSITIVE SKPCNT
	LD C, A
	LD A, (PDIREC)
	LD B, A
	CALL ENTSTK		; MAKE ENTRY
	JR PNTLP4		; CONTINUE UNTIL SKPCNT .LE. 0
PNTLP6:
	NEGHL  ; MAKE NEW SKPCNT POSITIVE
	DEC HL		; IF SKPCNT-MOVCNT .LT. -1
	DEC HL		; THEN RIGHT OVERHANG ENTRY IS NEEDED.
	LD A, H		; SEE IF POSITIVE.
	RLA
	JR C, GOPLOP		; OVERHANG TOO SMALL FOR NEW ENTRY
RTOVH0:
	INC HL		; NOW MOVE LEFT TO BEGINNING OF SCAN
	PUSH HL		; SO WE CAN ENTER A POSITIVE SKPCNT
	EX DE, HL
RTOVH1:
	CALL LEFTC		; START IS -(SKPCNT-MOVCNT)-1 TO LEFT
	DEC DE
	OR A
	JR NZ, RTOVH1
RTOVH2:
	POP DE		; GET BACK ENTRY SKPCNT INTO [DE]
	LD A, (PDIREC)		; MAKE ENTRY IN OPPOSITE DIRECTION
	CPL
	CALL ENTST1		; MAKE ENTRY
GOPLOP:
	JP PNTLOP		; GO PROCESS NEXT ENTRY
ENTSLR:
	LD A, (LFPROG)		; DON'T STACK IF SCANNED LINE
	LD C, A		; WAS ALREADY PAINTED
	LD A, (RTPROG)
	OR C
	RET Z
; Z IF SCAN LINE ALREADY PAINTED
ENTST0:
	LD A, (PDIREC)
ENTST1:
	LD B, A		; DIRECTION IN [B]
	CALL FETCHC		; LOAD REGS WITH CURRENT "C"
	LD C, A		; BIT MASK IN [C]
ENTSTK:
ENTST9:
	JP PUTQ
SCANR1:
	CALL SCANR		; PERFORM LOW LEVEL RIGHT SCAN
	LD (SKPCNT), DE		; SAVE UPDATED SKPCNT
	LD (MOVCNT), HL		; SAVE MOVCNT
	OR A		; SET CC'S ON MOVCNT
	LD A, C		; GET ALREADY-PAINTED FLAG FROM [C]
	LD (RTPROG), A
	RET
SCANL1:
	CALL FETCHC		; GET CURRENT LOCATION
	PUSH HL		; AND SWAP WITH CSV
	PUSH AF
	LD HL, (CSAVEA)
	LD A, (CSAVEM)
	CALL STOREC		; REPOS AT BEGINNING OF SCAN
	POP AF		; REGET PLACE WHERE RT SCN STOPPED
	POP HL
	LD (CSAVEA), HL		; AND SAVE IT IN TEMP LOCATION
	LD (CSAVEM), A
	CALL SCANL		; NOW DO LOW LEVEL LEFT SCAN
	LD A, C		; GET ALREADY-PAINTED FLAG FROM [C]
	LD (LFPROG), A		; WHETHER IT WAS ALREADY PAINTED
	RET
; ROUTINE FOR INITIALISING QUEUE PARAMS
; QUELEN:CONTAINS QUEUE LENGTH
; PSNLEN:CONTAINS PRESENT QUEUE LENGTH
; QUEINP:        QUEINPUT POINTER
; QUEOUT:        QUEOUTPUT POINTER
INTQUE:
	PUSH HL
; CSEG DATASG (public)
	EXTERN STREND:WORD
	LD HL, (STREND)		; GET BEGINNING OF FREE SPACE
	EX DE, HL
	PUSH DE
; CSEG DATASG (public)
	EXTERN FRETOP:WORD
	LD HL, (FRETOP)		; GET END OF FREE SPACE
	SBC HL, DE		; HL=FREE SPACE
	LD DE, 1000
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E		; IS IT LESSTHAN  1000 BYTES
	JP NC, INTQU2
	EXTERN GARBA2:NEAR
	CALL GARBA2		; CALL GARBAGE COLLECTION
INTQU2:
	POP DE		; GET BACK FREE START
	LD HL, (FRETOP)
	SBC HL, DE
	LD DE, 12
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E
	JP C, OMERR
	EXTERN OMERR:NEAR
; IF LESS THAN 12 BYTES GIVE MEMORY OVERFLOW
	LD (QUELEN), HL		; SET LENGTH OF QUEUE
	LD HL, 0
	LD (PSNLEN), HL		; SET PRESENT LENGTH
	LD HL, (STREND)		; HL=BEGINNING OF FREE SPACE
	LD (QUEINP), HL
	LD (QUEOUT), HL		; INIT QUEUE POINTERS
	POP HL		; GET BACK CALLERS HL
	RET
PUTQ:
	PUSH DE
	PUSH HL
	LD HL, (PSNLEN)		; GET QUEUE      PRESENT LENGTH
	LD DE, 6		; IS ENOUGH SPACE LEFT OUT
	EX AF, AF'
	ADD HL, DE
	EX AF, AF'
	LD (PSNLEN), HL		; UPDATE PRESENT LENGTH
	LD DE, (QUELEN)
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E
	JP NC, OMERR
; IF THE PRESENT LENGTH IS EQUAL TO MAX OR GREATER THEN GIVE ERROR
	LD HL, (QUEINP)
	CALL WRAP		; CHECK FOR WRAP AROUND CASE
	POP DE
	LD (HL), E
	INC HL
	LD (HL), D
	INC HL
	LD (HL), C
	INC HL
	LD (HL), B
	INC HL
	POP DE
	LD (HL), E
	INC HL
	LD (HL), D
	INC HL
	LD (QUEINP), HL
	RET
GETQ:
	LD HL, (PSNLEN)
	LD A, H
	OR L		; ANY ENTRYS ON STACK
	LD B, LOW 0		; FOR NO ENTRIES SET B TO ZERO
	RET Z
	LD DE, 6		; DECREMENT QUEUE LENGTH BY 6
	SBC HL, DE
	LD (PSNLEN), HL
	LD HL, (QUEOUT)		; HL=DEQUE POINTER
	CALL WRAP		; CHECK FOR WRAP AROUND
	LD E, (HL)
	INC HL
	LD D, (HL)
	INC HL
	PUSH DE
	LD C, (HL)
	INC HL
	LD B, (HL)
	INC HL
	LD E, (HL)
	INC HL
	LD D, (HL)
	INC HL
	LD (QUEOUT), HL
	POP HL
	RET
WRAP:
	PUSH HL
	LD DE, 6
	EX AF, AF'
	ADD HL, DE
	EX AF, AF'
	LD DE, (FRETOP)
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E		; ARE WE GOING OUT OF QUEUE END
	POP HL
	RET C
; NO
	LD HL, (STREND)		; SET TO BEGINNING OF QUEUE
	RET

;;; CIRCLE - Draw a circle ;;;

; 
;        CIRCLE - DRAW A CIRCLE
; 
;  SYNTAX: CIRCLE @(X,Y),RADIUS[,ATRB[,+/-STARTANG[,+/-ENDANG[,ASPECT]]]]
; 
	EXTERN GTASPC:NEAR
; CSEG DATASG (public)
	EXTERN ASPECT:WORD
	EXTERN CSTCNT:WORD
	EXTERN CENCNT:WORD
	EXTERN CRCSUM:WORD
	EXTERN CPLOTF:WORD
	EXTERN CLINEF:WORD
	EXTERN CNPNTS:WORD
	EXTERN CPCNT:WORD
	EXTERN CPCNT8:WORD
	EXTERN VALTYP:WORD
	EXTERN CXOFF:WORD
	EXTERN CYOFF:WORD
	EXTERN CSCLXY:WORD
	PUBLIC CIRCLE
CIRCLE:
	CALL SCAN1		; GET (X,Y) OF CENTER INTO GRPACX,Y
	CALL SYNCHR
	DB 44D
; EAT COMMA
	CALL GETIN2		; GET THE RADIUS
	PUSH HL		; SAVE TXTPTR
	EX DE, HL
	LD (GXPOS), HL		; SAVE HERE TILL START OF MAIN LOOP
	CALL MKINTC		; PUT INTEGER INTO FAC
	EXTERN FRCSNG:NEAR
	CALL FRCSNG		; CONVERT TO SINGLE PRECISION
	LD BC, 32821		; LOAD REGS WITH SQR(2)/2
	LD DE, 1267
	EXTERN FMULT:NEAR
	CALL FMULT		; DO FLOATING PT MULTIPLY
	EXTERN FRCINT:NEAR
	CALL FRCINT		; CONVERT TO INTEGER & GET INTO [HL]
	LD (CNPNTS), HL		; CNPNTS=RADIUS*SQR(2)/2=# PTS TO PLOT
	XOR A		; ZERO OUT CLINEF - NO LINES TO CENTER
	LD (CLINEF), A
	LD (CSCLXY), A		; INITIALLY SCALING Y
	POP HL		; REGET TXTPTR
	CALL ATRSCN		; SCAN POSSIBLE ATTRIBUTE
	LD C, LOW 1		; SET LO BIT IN CLINEF FOR LINE TO CNTR
	LD DE, 0		; DEFAULT START COUNT = 0
	CALL CGTCNT
	PUSH DE		; SAVE COUNT FOR LATER COMPARISON
	LD C, LOW 128		; SET HI BIT IN CLINEF FOR LINE TO CNTR
	LD DE, OFFSET 0 -1		; DEFAULT END COUNT = INFINITY
	CALL CGTCNT
	EX (SP), HL		; XTHL
; GET START COUNT, PUSH TXTPTR TILL DONE
	XOR A
	EX DE, HL		; REVERSE REGS TO TEST FOR .LT.
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E		; SEE IF END .GE. START
	LD A, LOW 0
	JR NC, CSTPLT		; YES, PLOT POINTS BETWEEN STRT & END
	DEC A		; PLOT POINTS ABOVE & BELOW
	EX DE, HL		; SWAP START AND END SO START .LT. END
	PUSH AF		; Swap sense of center line flags
	LD A, (CLINEF)
	LD C, A
	RLA
	RLA
	OR C
	RRA
	LD (CLINEF), A		; Store swapped flags
	POP AF
CSTPLT:
	LD (CPLOTF), A		; SET UP PLOT POLARITY FLAG
	LD (CSTCNT), DE		; STORE START COUNT
	LD (CENCNT), HL		; AND END COUNT
	POP HL		; GET TXTPTR
	DEC HL		; NOW SEE IF LAST CHAR WAS A COMMA
	CALL CHRGTR
	JR NZ, CIRC1		; SOMETHING THERE
	PUSH HL		; SAVE TXTPTR
	CALL GTASPC		; GET DEFAULT ASPECT RATIO INTO [HL]
	LD A, H
	OR A		; IS ASPECT RATIO GREATER THAN ONE?
	JR Z, CIRC2		; BRIF GOOD ASPECT RATIO
	LD A, LOW 1
	LD (CSCLXY), A
	EX DE, HL		; ASPECT RATIO IS GREATER THAN ONE, USE INVERSE
	JR CIRC2		; NOW GO CONVERT TO FRACTION OF 256
CIRC1:
	CALL SYNCHR
	DB 44D
; EAT COMMA
	EXTERN FRMEVL:NEAR
	CALL FRMEVL
	PUSH HL		; SAVE TXTPTR
	CALL FRCSNG		; MAKE IT FLOATING POINT
	CALL CMPONE		; SEE IF GREATER THAN ONE
	JR NZ, CIRC11		; LESS THAN ONE - SCALING Y
	INC A		; MAKE [A] NZ
	LD (CSCLXY), A		; FLAG SCALING X
	CALL FDIV		; RATIO = 1/RATIO
; MAKE NUMBER FRACTION OF 256
; CSEG DATASG (public)
	EXTERN FAC:WORD
CIRC11:
	LD HL, (FAC)		; BY MULTIPLYING BY 2^8 (256)
	LD A, (HL)
	ADD A, LOW 8		; ADD 8 TO EXPONENT
	LD (HL), A
	CALL FRCINT		; MAKE IT AN INTEGER IN [HL]
CIRC2:
	LD (ASPECT), HL		; STORE ASPECT RATIO
; 
;        CIRCLE ALGORITHM
; 
;        [HL]=X=RADIUS * 2 (ONE BIT FRACTION FOR ROUNDING)
;        [DE]=Y=0
;        SUM =0
;  LOOP: IF Y IS EVEN THEN
;              REFLECT((X+1)/2,(Y+1)/2) (I.E., PLOT POINTS)
;              IF X.LT.Y THEN EXIT
;        SUM=SUM+2*Y+1
;        Y=Y+1
;        IF SUM.GGWGRP.RNO
;              SUM=SUM-2*X+1
;              X=X-1
;        ENDIF
;        GOTO LOOP
; 
	LD DE, 0		; INIT Y = 0
	LD (CRCSUM), DE		; SUM = 0
	LD HL, (GXPOS)		; X = RADIUS*2
	ADD HL, HL
CIRCLP:
	LD A, E		; TEST EVENNESS OF Y
	RRCA		; TO SEE IF WE NEED TO PLOT
	JR C, CRCLP2		; Y IS ODD - DON'T TEST OR PLOT
	PUSH DE		; SAVE Y AND X
	PUSH HL
	INC HL		; ACTUAL COORDS ARE (X+1)/2,(Y+1)/2
	HLFHL  ; (PLUS ONE BEFORE DIVIDE TO ROUND UP)
	INC DE
	HLFDE 
	CALL CPLOT8
	POP DE		; RESTORE X AND Y
	POP HL		; INTO [DE] AND [HL] (BACKWARDS FOR CMP)
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E		; QUIT IF Y .GE. X
	JP NC, POPTRT
; GO POP TXTPTR AND QUIT
	EX DE, HL		; GET OFFSETS INTO PROPER REGISTERS
CRCLP2:
	PUSH BC
	POP HL
			; [BC]=X
	LD HL, (CRCSUM)
	INC HL		; SUM = SUM+2*Y+1
	ADD HL, DE
	ADD HL, DE
	LD A, H		; NOW CHECK SIGN OF RESULT
	RLA
	JR C, CNODEX		; DON'T ADJUST X IF WAS NEGATIVE
	PUSH DE		; SAVE Y
	EX DE, HL		; [DE]=SUM
	PUSH HL
	POP BC
			; [HL]=X
	ADD HL, HL		; [HL]=2*X-1
	DEC HL
	EX DE, HL		; PREPARE TO SUBTRACT
	SBC HL, DE		; CALC SUM-2*X+1
	DEC BC		; X=X-1
	POP DE		; GET Y BACK
CNODEX:
	LD (CRCSUM), HL		; UPDATE CIRCLE SUM
	PUSH HL
	POP BC
			; GET X BACK TO [HL]
	INC DE		; Y=Y+1
	JR CIRCLP
CPLSCX:
	PUSH DE
	CALL SCALEY
	POP HL		; GET UNSCALED INTO [HL]
	LD A, (CSCLXY)		; SEE WHETHER ASPECT WAS .GT. 1
	OR A
	RET Z
; DON'T SWAP IF ZERO
	EX DE, HL
	RET
; 
;  REFLECT THE POINTS AROUND CENTER
;  [HL]=X OFFSET FROM CENTER, [DE]=Y OFFSET FROM CENTER
; 
CPLOT8:
	LD (CPCNT), DE		; POINT COUNT IS ALWAYS = Y
	PUSH HL		; SAVE X
	LD HL, 0		; START CPCNT8 OUT AT 0
	LD (CPCNT8), HL
	CALL CPLSCX		; SCALE Y AS APPROPRIATE
	LD (CXOFF), HL		; SAVE CXOFF
	POP HL		; GET BACK X
	EX DE, HL
	PUSH HL		; SAVE INITIAL [DE]
	CALL CPLSCX		; SCALE X AS APPROPRIATE
	LD (CYOFF), DE
	POP DE		; GET BACK INITIAL [DE]
	NEGDE  ; START: [DE]=-Y,[HL]=X,CXOFF=Y,CY=X
	CALL CPLOT4		; PLOT +X,-SY -Y,-SX -X,+SY +Y,-SX
	PUSH HL
	PUSH DE
	LD HL, (CNPNTS)		; GET # PNTS PER OCTANT
	LD (CPCNT8), HL		; AND SET FOR DOING ODD OCTANTS
	LD DE, (CPCNT)		; GET POINT COUNT
	SBC HL, DE		; ODD OCTANTS ARE BACKWARDS SO
	LD (CPCNT), HL		; PNTCNT = PNTS/OCT - PNTCNT
	LD HL, (CXOFF)		; NEED TO NEGATE CXOFF TO START OUT RIGHT
	NEGHL 
	LD (CXOFF), HL
	POP DE
	POP HL
	NEGDE  ; ALSO NEED TO MAKE [DE]=-SX=-[DE]
; PLOT +Y,-SX -X,-SY -Y,+SX +X,+SY
; (FALL THRU TO CPLOT4)
CPLOT4:
	LD A, LOW 4		; LOOP FOUR TIMES
CPLOT:
	PUSH AF		; SAVE LOOP COUNT
	PUSH HL		; SAVE BOTH X & Y OFFSETS
	PUSH DE
	PUSH HL		; SAVE TWICE
	PUSH DE
	LD DE, (CPCNT8)		; GET NP*OCTANT*8
	LD HL, (CNPNTS)		; ADD SQR(2)*RADIUS FOR NEXT OCTANT
	ADD HL, HL
	ADD HL, DE
	LD (CPCNT8), HL		; UPDATE FOR NEXT TIME
	LD HL, (CPCNT)		; CALC THIS POINT'S POINT COUNT
	ADD HL, DE		; ADD IN PNTCNT*OCTANT*NP
	EX DE, HL		; SAVE THIS POINT'S COUNT IN [DE]
	LD HL, (CSTCNT)		; GET START COUNT
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E
	JR Z, CLINSC		; SEE IF LINE TO CENTER REQUIRED
	JR NC, CNBTWN		; IF SC .GT. PC, THEN NOT BETWEEN
	LD HL, (CENCNT)		; GET END COUNT
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E
	JR Z, CLINEC		; GO SEE IF LINE FROM CENTER NEEDED
	JR NC, CBTWEN		; IF EC .GT. PC, THEN BETWEEN
CNBTWN:
	LD A, (CPLOTF)		; SEE WHETHER TO PLOT OR NOT
	OR A		; IF NZ, PLOT POINTS NOT IN BETWEEN
	JR NZ, CPLTIT		; NEED TO PLOT NOT-BETWEEN POINTS
	JR GCPLFN		; DON'T PLOT - FIX UP STACK & RETURN
CLINEC:
	LD A, (CLINEF)		; GET CENTER LINE FLAG BYTE
	RLA		; BIT 7=1 MEANS DRAW LINE FROM CENTER
	JR NC, CPLTIT		; NO LINE REQUIRED - JUST PLOT POINT
	JR CLINE		; LINE REQUIRED.
CLINSC:
	LD A, (CLINEF)		; GET CENTER LINE FLAG BYTE
	RRCA		; BIT 0=1 MEANS LINE FROM CENTER NEEDED.
	JR NC, CPLTIT		; NO LINE REQUIRED - JUST PLOT POINT
CLINE:
	POP DE		; GET X & Y OFFSETS
	POP HL
	CALL GTABSC		; GO CALC TRUE COORDINATE OF POINT
	CALL CLINE2		; DRAW LINE FROM [BC],[DE] TO CENTER
	JR CPLFIN
CBTWEN:
	LD A, (CPLOTF)		; SEE WHETHER PLOTTING BETWEENS OR NOT
	OR A
	JR Z, CPLTIT		; IF Z, THEN DOING BETWEENS
GCPLFN:
	POP DE		; CLEAN UP STACK
	POP HL
	JR CPLFIN
CPLTIT:
	POP DE		; GET X & Y OFFSETS
	POP HL
	CALL GTABSC		; CALC TRUE COORDINATE OF POINT
	CALL SCALXY		; SEE IF POINT OFF SCREEN
	JR NC, CPLFIN		; NC IF POINT OFF SCREEN - NO PLOT
	CALL MAPXYC
	CALL SETC		; PLOT THE POINT
CPLFIN:
	POP DE		; GET BACK OFFSETS
	POP HL
	POP AF		; GET BACK LOOP COUNT
	DEC A
	RET Z
; QUIT IF DONE.
	PUSH AF		;  PUSH PSW
	PUSH DE		; SAVE X OFFSET
	LD DE, (CXOFF)		; SWAP [HL] AND CXOFF
	NEGDE  ; NEGATE NEW [HL]
	LD (CXOFF), HL
	EX DE, HL
	POP DE
	PUSH HL
	LD HL, (CYOFF)		; SWAP [DE] AND CYOFF
	EX DE, HL		; NEGATE NEW [DE]
	LD (CYOFF), HL
	NEGDE 
	POP HL
	POP AF		;  POP PSW
	JP CPLOT		; PLOT NEXT POINT
CLINE2:
	LD HL, (GRPACX)		; DRAW LINE FROM [BC],[DE]
	LD (GXPOS), HL		; TO GRPACX,Y
	LD HL, (GRPACY)
	LD (GYPOS), HL
	JP DOGRPH		; GO DRAW THE LINE
; 
;  GTABSC - GET ABSOLUTE COORDS
;  ([BC],[DE])=(GRPACX+[HL],GRPACY+[DE])
; 
GTABSC:
	PUSH DE		; SAVE Y OFFSET FROM CENTER
	LD DE, (GRPACX)		; GET CENTER POS
	ADD HL, DE		; ADD TO DX
	PUSH BC
	POP HL
			; [BC]=X CENTER + [HL]
	POP DE
	LD HL, (GRPACY)		; GET CENTER Y
	ADD HL, DE
	EX DE, HL		; [DE]=Y CENTER + [DE]
	RET
SCALEY:
	LD HL, (ASPECT)		; SCALE [DE] BY ASPECT RATIO
SCALE:
	LD A, L		; CHECK FOR *0 AND *1 CASES
SCALE2:
	OR A		; ENTRY TO DO [A]*[DE] ([A] NON-Z)
	JR NZ, SCAL2		; NON-ZERO
	OR H		; TEST HI BYTE
	RET NZ
; IF NZ, THEN WAS *1 CASE
	EX DE, HL		; WAS *0 CASE - PUT 0 IN [DE]
	RET
SCAL2:
	; MUL 16-by-8 ('AL', 'DX', 'DL')		; XORB AH,AH
; MUL  DX
; MOVB DH,DL
; ADDI AX,128  - ROUND UP
	; ADD AX, 128D
	JP NC, 2		; JNB NOCARY
	INC D		; INCB DH
NOCARY:
	LD E, AH		; MOVB DL,AH
	RET
; 
;  PARSE THE BEGIN AND END ANGLES
;   SETTING APPROPRIATE BITS IN CLINEF IF NEG.
; 
CGTCNT:
	DEC HL
	CALL CHRGTR		; GET CURRENT CHAR
	RET Z
; IF NOTHING, RETURN DFLT IN [DE]
	CALL SYNCHR
	DB 44D
; EAT THE COMMA
	CP 44		; USE DEFAULT IF NO ARGUMENT.
	RET Z
	PUSH BC		; SAVE FLAG BYTE IN [C]
	CALL FRMEVL		; EVALUATE THE THING
	EX (SP), HL		; XTHL
; POP FLAG BYTE, PUSH TXTPTR
	PUSH HL		; RESAVE FLAG BYTE
	CALL FRCSNG		; MAKE IT A SINGLE PRECISION VALUE
	POP BC		; GET BACK FLAG BYTE
	LD HL, (FAC)		; NOW SEE WHETHER POSITIVE OR NOT
	LD A, (HL)		; GET EXPONENT BYTE
	OR A
	JR Z, CGTC2
	DEC HL
; SET TO HIGH MANTISSA BYTE
	LD A, (HL)
	OR A
	JP P, CGTC2
	AND LOW 127		; MAKE IT POSITIVE
	LD (HL), A
	LD HL, (CLINEF)		; SET BIT IN [C] IN CLINEF
	LD A, (HL)
	OR C
	LD (HL), A
CGTC2:
	LD BC, 32290		; LOAD REGS WITH 1/2*PI
	LD DE, 63875
	CALL FMULT		; MULTIPLY BY 1/(2*PI) TO GET FRACTION
	CALL CMPONE		; SEE IF RESULT IS GREATER THAN ONE
	JP Z, FCERR
; FC ERROR IF SO
	EXTERN PUSHF:NEAR
	CALL PUSHF		; SAVE FAC ON STAC
	LD HL, (CNPNTS)		; GET NO. OF POINTS PER OCTANT
	ADD HL, HL		; TIMES 8 FOR TRUE CIRCUMFERENCE
	ADD HL, HL
	ADD HL, HL
	CALL MKINTC		; STICK IT IN FAC
	CALL FRCSNG		; AND MAKE IT SINGLE PRECISION
	POP BC		; GET BACK ANG/2*PI IN REGS
	POP DE
	CALL FMULT		; DO THE MULTIPLY
	CALL FRCINT		; CONVERT TO INTEGER IN [HL]
	POP DE		; GET BACK TXTPTR
	EX DE, HL
	RET
CMPONE:
	LD BC, 33024		; MAKE SURE FAC IS LESS THAN ONE
	LD DE, 0
	EXTERN FCOMP:NEAR
	CALL FCOMP
	DEC A
	RET

;;; GET and PUT - read and write graphics bit array ;;;

; 
;        GET & PUT - READ & WRITE GRAPHICS BIT ARRAY
; 
;  SYNTAX:
;        GET @(X,Y),ARRAYVAR
;        PUT @(X,Y),ARRAYVAR[,FUNCTION]
; 
;        FUNCTION = OR/AND/PRESET/PSET/XOR
; 
	EXTERN PGINIT:NEAR
	EXTERN PIXSIZ:NEAR
	EXTERN NREAD:NEAR
	EXTERN NWRITE:NEAR
	EXTERN XDELT:NEAR
	EXTERN $AND:NEAR
	EXTERN $OR:NEAR
	EXTERN $PRESET:NEAR
	EXTERN $PSET:NEAR
	EXTERN $XOR:NEAR
	EXTERN YDELT:NEAR
	EXTERN XCHGX:NEAR
	EXTERN XCHGY:NEAR
; CSEG DATASG (public)
	EXTERN PUTFLG:WORD
	EXTERN MINDEL:WORD
	EXTERN MAXDEL:WORD
	PUBLIC GPUTG
GPUTG:
	LD (PUTFLG), A		; IFE PC8A&RSTLES-1STORE WHETHER PUTTING OR NOT
	PUSH AF		; SAVE THIS FLAG A SEC
	PUSH HL		; Save text pointer
	CALL PIXSIZ		; Test for graphics mode
	OR A
	JP Z, FCERR
; Not a graphics mode
	POP HL
	CALL SCAN1		; GET FIRST COORD
	CALL CHKRNG
	POP AF		; REGET PUT FLAG
	OR A
	JP NZ, PUT1
	CALL SYNCHR
	DB MINUTK
; EAT "-"
	PUSH BC		; SAVE X1
	PUSH DE		; SAVE Y1
	CALL SCAND		; GET SECOND COORD FOR 'GET' ONLY
	CALL CHKRNG
	POP DE		; GET Y1 BACK
	POP BC		; AND X1
	PUSH HL		; SAVE TXTPTR
	CALL YDELT		; CALC DELTA Y
	CALL C, XCHGY
; MAKE DE=MIN(GXPOS,DE)
	INC HL		; MAKE DELTA A COUNT
	LD (MINDEL), HL		; SAVE DELTA Y IN MIDEL
	CALL XDELT
	CALL C, XCHGX
; BC = MIN(GXPOS,DE)
	INC HL		; MAKE DELTA A COUNT
	LD (MAXDEL), HL		; SAVE DX IN MAXDEL
	CALL MAPXYC
	POP HL		; GET BACK TXTPTR
	CALL GTARRY		; SCAN ARRAY NAME
	PUSH HL		; SAVE TXTPTR UNTIL DONE
	PUSH DE		; SAVE BEG. OF ARRAY DATA PTR
	PUSH BC		; SAVE END OF ARRAY DATA PTR
	PUSH DE		; SAVE BEG. PTR AGAIN FOR COMPAR
	CALL PIXSIZ		; GET # BITS PER PIXEL INTO [A]
	LD DE, (MAXDEL)
	LD HL, 0
MULBLP:
	ADD HL, DE		; CALC DX * BITS/PIX
	DEC A
	JR NZ, MULBLP		; KEEP LOOPING
	PUSH BC
	POP HL
			; SAVE THIS IS [BC]
	LD DE, OFFSET (0, '+7')		; Round to byte boundry.
	ADD HL, DE
	EX DE, HL		; RESULT TO [DE]
	HLFDE  ; NOW CALC NO. OF BYTES PER SCAN LINE
	HLFDE 
	HLFDE 
	LD HL, (MINDEL)		; GET DELTA Y
	PUSH BC		; SAVE DX*BITS/PIX
	PUSH BC
	POP HL
			; INTO [BC] FOR UMULT
	CALL UMULT		; [DE]=DX*DY*BITS/PIX
	POP BC		; GET BACK DX*BITS/PIX
	LD HL, 4		; ADD 4 BYTES FOR DX,DY STORAGE
	ADD HL, DE		; [HL] HAS NO. OF BYTES TO BE USED
	POP DE		; BEG OF ARRAY DATA TO [HL]
	ADD HL, DE		; ADD NO. OF BYTES TO BE USED
	EX DE, HL		; [DE] = CALCULATED END OF DATA
	POP HL		; END OF ARRAY DATA TO [HL]
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E
	JP C, FCERR
; ERROR IF TOO BIG
; BEG OF DATA PTR IS ON STK HERE
	POP HL		; GET POINTER TO ARRAY DATA
	LD A, H
	SUB D
	RET NZ
	LD A, L
	SUB E
	JP NC, FCERR
; ARRAY START+LENGTH .GT. 64K
	LD (HL), C		; SAVE DX*BITS/PIX IN 1ST 2 BYTES OF ARY
	INC HL
	LD (HL), B		; PASS NO. OF BITS DESIRED IN [BC]
	INC HL
	LD DE, (MINDEL)		; GET LINE (Y) COUNT
	LD (HL), DE
	INC HL
	INC HL		; SAVE DY IN 2ND 2 BYTES
	OR A		; CLEAR CARRY FOR GET INIT.
	JP GOPGIN		; GIVE LOW LEVEL ADDR OF ARRAY & GO
PUT1:
	PUSH HL		; SAVE TXTPTR
	CALL MAPXYC		; MAP THE POINT
	POP HL
	CALL GTARRY		; SCAN ARRAY NAME & GET PTR TO IT
	PUSH DE		; SAVE PTR TO DELTAS IN ARRAY
	DEC HL		; NOW SCAN POSSIBLE PUT OPTION
	CALL CHRGTR
	LD B, LOW 5		; DEFAULT OPTION IS XOR
	JR Z, PUT2		; IF NO CHAR, USE DEFAULT
	CALL SYNCHR
	DB 44D
; MUST BE A COMMA
	EX DE, HL		; PUT TXTPTR IN [DE]
	LD HL, OFFSET GFUNTB +4		; TABLE OF POSSIBLE OPTIONS
PFUNLP:
; CS OVERRIDE
	CP (HL)		; IS THIS AN OPTION?
	JR Z, PUT20		; YES, HAND IT TO PGINIT.
	DEC HL		; POINT TO NEXT
	DJNZ PFUNLP
	EX DE, HL		; GET TXTPTR BACK TO [HL]
	POP DE		; CLEAN UP STACK
	RET		; LET NEWSTT GIVE SYNTAX ERROR
PUT20:
	EX DE, HL		; GET TXTPTR BACK TO [HL]
	CALL CHRGTR		; EAT THE TOKEN
PUT2:
	DEC B		; 1..5 -TO 0..4
	LD A, B		; INTO [A] FOR PGINIT
	EX (SP), HL		; XTHL
; POP ARRAY PTR, PUSH TXTPTR
	PUSH AF		; SAVE PUT ACTION MODE
	LD DE, (HL)		; [DE]=NO. OF BITS IN X
	INC HL
	INC HL
	PUSH DE		; SAVE BIT COUNT
	PUSH HL		; SAVE ARRAY POINTER
	EX DE, HL		; INTO [HL] FOR IDIV
	CALL PIXSIZ		; GET BITS/PIXEL INTO [DE]
	LD E, A		; INTO [E] FOR COUNTING
IF PWR2PX
DIVBLP:
	DEC E		; DIVIDE BY [E] (POWER-OF-2 CASE)
	JP Z, DIVBTX
	HLFHL  ; DIVIDE BY TWO [E]-1 TIMES
	JR DIVBLP
DIVBTX:
ENDIF
	IF (PWR2PX) = 0
	EXTERN IDIV:NEAR
	LD D, LOW 0
	EX DE, HL		; IDIV divides DE by HL
	CALL IDIV		; CALC NO. OF POINTS
ENDIF
	DEC HL		; DECREMENT DX SINCE IT'S A COUNTER
	LD DE, (GXPOS)		; NOW CALC TRUE X
	ADD HL, DE
	JR C, PRNGER		; ERROR IF CARRY
	PUSH BC
	POP HL
			; TO [BC] FOR SCALXY
	POP HL		; GET BACK ARRAY POINTER
	LD DE, (HL)		; [DE] = DELTA Y ([HL] POINTS TO DATA)
	INC HL
	INC HL
	PUSH DE		; SAVE DELTA Y ON STACK
	PUSH HL		; SAVE PTR ON STACK AGAIN
	LD HL, (GYPOS)
	DEC DE		; DECREMENT DY SINCE IT'S A COUNTER
	ADD HL, DE
PRNGER:
	JP C, FCERR
; ERROR IF CARRY
	EX DE, HL		; [DE]=Y + DELTA Y
	POP HL		; GET BACK ARRAY POINTER
	CALL CHKRNG		; MAKE SURE [BC],[HL] ARE ON THE SCREEN
	POP DE		; POP DY
	POP BC		; POP DX*BITS/PIX
	POP AF		; GET BACK ACTION MODE
	SCF		; SET CARRY TO FLAG PUT INIT
GOPGIN:
	PUSH DE		; RESAVE DY
	CALL PGINIT		; [BC]=BIT COUNT,[HL]=ARRAY ADDR
	POP DE		; GET Y COUNT
PGLOOP:
	PUSH DE		; SAVE LINE COUNT
	LD A, (PUTFLG)		; SEE IF PUTTING OR GETTING
	OR A
	JR NZ, PGLOO2
	CALL NREAD
	JR PGLOO3
PGLOO2:
	CALL NWRITE
PGLOO3:
	CALL DOWNC		; NOW MOVE DOWN A LINE
	POP DE
	DEC DE
	OR A
	JR NZ, PGLOOP		; CONTINUE IF NOT ZERO
	POP HL		; GET BACK TXTPTR
	RET		; AND RETURN
GTARRY:
	CALL SYNCHR
	DB 44D
; EAT COMMA
	LD A, LOW 1		; SEARCH ARRAYS ONLY
; CSEG DATASG (public)
	EXTERN SUBFLG:WORD
	LD (SUBFLG), A
	EXTERN PTRGET:NEAR
	CALL PTRGET		; GET PTR TO ARRAY
	JP NZ, FCERR
; NOT THERE - ERROR
	LD (SUBFLG), A		; CLEAR THIS
	PUSH HL		; SAVE TXTPTR
	PUSH HL
	POP BC
			; HL = PTR TO ARRAY
	EX DE, HL		; HL = LENGTH
	ADD HL, DE		; HL = LAST BYTE OF ARRAY
	PUSH HL		; SAVE
	LD IYH, B
	LD IYL, C
	LD A, (IY)		; GET NO. OF DIMS
	RLA		; DOUBLE SINCE 2 BYTE ENTRIES
	LD L, A
	LD H, LOW 0
	INC BC		; SKIP NO. OF DIMS
	ADD HL, BC
	EX DE, HL		; DE = PTR TO FIRST BYTE OF DATA
	POP BC		; BC = PTR TO LAST BYTE OF DATA
	POP HL		; GET TXTPTR
	RET
GFUNTB:
	DB $OR
; LIST OF VALID PUT OPTIONS
	DB $AND
	DB $PRESET
	DB $PSET
	DB $XOR

;;; GRAPHICS MACRO LANGUAGE SUPPORT ;;;

; 
;  GRAPHICS MACRO LANGUAGE SUPPORT
; 
	EXTERN VALSCN:NEAR
	EXTERN DECFET:NEAR
	EXTERN MACLNG:NEAR
	EXTERN MCLXEQ:NEAR
	EXTERN FETCHZ:NEAR
	EXTERN NEGD:NEAR
; CSEG DATASG (public)
	EXTERN DRWFLG:WORD
	EXTERN DRWSCL:WORD
	EXTERN DRWANG:WORD
	PUBLIC DRAW
DRAW:
	PUSH HL		; Save text pointer
	CALL PIXSIZ		; Get bits/pixel
	OR A		; Test for 0 (text only mode)
	JP Z, FCERR
; DRAW not allowed in text mode
	POP HL		; Restore text pointer
	LD DE, OFFSET DRWTAB		; DISPATCH TABLE FOR GML
	XOR A		; CLEAR OUT DRAW FLAGS
	LD (DRWFLG), A
	JP MACLNG		; GO DO IT.
DRWTAB:
	DB "U"+128D
; UP
	ADR DRUP ;  ASM86 doesn't like DUP, 9-Jul-82/NGT
	DB "D"+128D
; DOWN
	ADR DRDOWN
	DB "L"+128D
; LEFT
	ADR DRLEFT
	DB "R"+128D
; RIGHT
	ADR DRIGHT
	DB "M"
; MOVE
	ADR DMOVE
	DB "E"+128D
; -,-
	ADR DRWEEE
	DB "F"+128D
; +,-
	ADR DRWFFF
	DB "G"+128D
; +,+
	ADR DRWGGG
	DB "H"+128D
; -,+
	ADR DRWHHH
	DB "A"+128D
; ANGLE COMMAND
	ADR DANGLE
	DB "B"
; MOVE WITHOUT PLOTTING
	ADR DNOPLT
	DB "N"
; DON'T CHANGE CURRENT COORDS
	ADR DNOMOV
	DB "X"
; EXECUTE STRING
	ADR MCLXEQ
	DB "C"+128D
; COLOR
	ADR DCOLR
	DB "S"+128D
; SCALE
	ADR DSCALE
	DB 0D
; END OF TABLE
DRUP:
	NEGDE  ; MOVE +0,-Y
DRDOWN:
; MOVE +0,+Y
	LD BC, 0		; DX=0
	JR DOMOVR		; TREAT AS RELATIVE MOVE
DRLEFT:
	NEGDE  ; MOVE -X,+0
DRIGHT:
; MOVE +X,+0
	PUSH BC
	POP DE
			; [BC]=VALUE
	LD DE, 0		; DY=0
	JR DOMOVR		; TREAT AS RELATIVE MOVE
DRWHHH:
	NEGDE  ; MOVE -X,-Y
DRWFFF:
	PUSH BC
	POP DE
			; MOVE +X,+Y
	JR DOMOVR
DRWEEE:
	PUSH BC
	POP DE
			; MOVE +X,-Y
DRWHHC:
	NEGDE 
	JR DOMOVR
DRWGGG:
	NEGDE  ; MOVE -X,+Y
	PUSH BC
	POP DE
	
	JR DRWHHC		; MAKE DY POSITIVE & GO
DMOVE:
	CALL FETCHZ		; GET NEXT CHAR AFTER COMMA
	LD B, LOW 0		; ASSUME RELATIVE
	CP "+"		; IF "+" OR "-" THEN RELATIVE
	JR Z, MOVREL
	CP "-"
	JR Z, MOVREL
	INC B		; NON-Z TO FLAG ABSOLUTE
MOVREL:
	LD A, B
	PUSH AF		; SAVE ABS/REL FLAG ON STACK
	CALL DECFET		; BACK UP SO VALSCN WILL SEE "-"
	CALL VALSCN		; GET X VALUE
	PUSH DE		; SAVE IT
	CALL FETCHZ		; NOW CHECK FOR COMMA
	CP 44		; COMMA?
	JP NZ, FCERR
	CALL VALSCN		; GET Y VALUE IN D
	POP BC		; GET BACK X VALUE
	POP AF		; GET ABS/REL FLAG
	OR A
	JR NZ, DRWABS		; NZ - ABSOLUTE
DOMOVR:
	CALL DSCLDE		; ADJUST Y OFFSET BY SCALE
	PUSH DE		; SAVE Y OFFSET
	PUSH DE
	POP BC
			; GET X INTO [DE]
	CALL DSCLDE		; GO SCALE IT.
	EX DE, HL		; GET ADJUSTED X INTO [HL]
	POP DE		; GET ADJUSTED Y INTO [DE]
	XOR A
	LD (CSCLXY), A
	LD A, (DRWANG)		; GET ANGLE BYTE
	RRCA		; LOW BIT TO CARRY
	JR NC, ANGEVN		; ANGLE IS EVEN - DON'T SWAP X AND Y
	PUSH AF		; SAVE THIS BYTE
	PUSH DE		; SAVE DY
	PUSH HL		; SAVE DX
	CALL GTASPC		; GO GET SCREEN ASPECT RATIO
; NOTE: TOSHIBA GTASPC routine does this logic(i.e. it sets CSCLXY if aspect
;                    ratio is greater than one).
	LD A, H
	OR A		; IS ASPECT RATIO GREATER THAN ONE?
	JR Z, ASPLS0		; BRIF GOOD ASPECT RATIO
	LD A, LOW 1
	LD (CSCLXY), A
	EX DE, HL
ASPLS0:
	LD C, L		; GET ASPECT RATIO INTO [C] FOR GOSCAL
	POP HL		; GET BACK DX
	LD A, (CSCLXY)
	OR A
	JR Z, ASPLS1		; branch if aspect ratio less 1.0
	EX (SP), HL		; XTHL
; [HL]=DY, save DX
ASPLS1:
	EX DE, HL		; 1/ASPECT TO [HL]
	PUSH HL		; SAVE 1/ASPECT
	CALL GOSCAL		; SCALE DELTA X BY ASPECT RATIO
	POP BC		; GET BACK 1/ASPECT RATIO
	POP HL		; GET DY
	PUSH DE		; SAVE SCALED DX
	EX DE, HL		; DY TO [DE] FOR GOSCAL
	LD HL, 0
DMULP:
	ADD HL, DE		; MULTIPLY [DE] BY HI BYTE OF 1/ASPECT
	DJNZ DMULP
	PUSH HL		; SAVE PARTIAL RESULT
	CALL GOSCAL		; MULTIPLY [DE] BY LOW BYTE
	POP HL		; GET BACK PARTIAL RESULT
	ADD HL, DE		; [HL]=Y * 1/ASPECT
	POP DE		; GET BACK SCALED Y
	LD A, (CSCLXY)
	OR A
	JR Z, ASLSS1		; branch if aspect ratio less than 1
	EX DE, HL
ASLSS1:
	NEGDE  ; ALWAYS NEGATE NEW DY
	POP AF		; GET BACK SHIFTED ANGLE
ANGEVN:
	RRCA		; TEST SECOND BIT
	JR NC, ANGPOS		; DON'T NEGATE COORDS IF NOT SET
	NEGHL 
	NEGDE  ; NEGATE BOTH DELTAS
ANGPOS:
	CALL GTABSC		; GO CALC TRUE COORDINATES
DRWABS:
	LD A, (DRWFLG)		; SEE WHETHER WE PLOT OR NOT
	RLA		; CHECK HI BIT
	JR C, DSTPOS		; JUST SET POSITION.
	PUSH AF		; SAVE THIS FLAG
	PUSH BC		; SAVE X,Y COORDS
	PUSH DE		; BEFORE SCALE SO REFLECT DISTANCE OFF
	CALL SCALXY		; SCALE IN CASE COORDS OFF SCREEN
	CALL CLINE2
	POP DE
	POP BC		; GET THEM BACK
	POP AF		; GET BACK FLAG
DSTPOS:
	RLA		; SEE WHETHER TO STORE COORDS
	JR C, DNSTOR		; DON'T UPDATE IF B6=1
	LD (GRPACY), DE		; UPDATE GRAPHICS AC
	PUSH HL
	POP BC
	
	LD (GRPACX), HL
DNSTOR:
	XOR A		; CLEAR SPECIAL FUNCTION FLAGS
	LD (DRWFLG), A
	RET
DNOMOV:
	LD A, LOW 64		; SET BIT SIX IN FLAG BYTE
	JR DSTFLG
DNOPLT:
	LD A, LOW 128		; SET BIT 7
DSTFLG:
	LD HL, (DRWFLG)
	OR (HL)
	LD (HL), A		; STORE UPDATED BYTE
	RET
DANGLE:
	JR NC, NCFCER		; ERROR IF NO ARG
	LD A, E		; MAKE SURE LESS THAN 4
	CP 4
	JR NC, NCFCER		; ERROR IF NOT
	LD (DRWANG), A
	RET
NCFCER:
DSCALE:
	JP NC, FCERR
; FC ERROR IF NO ARG
	LD A, D		; MAKE SURE LESS THAN 256
	OR A
	JP NZ, FCERR
	LD A, E
	LD (DRWSCL), A		; STORE SCALE FACTOR
	RET
DSCLDE:
	LD A, (DRWSCL)		; GET SCALE FACTOR
	OR A		; ZERO MEANS NO SCALING
	RET Z
	LD HL, 0
DSCLP:
	ADD HL, DE		; ADD IN [DE] SCALE TIMES
	DEC A
	JR NZ, DSCLP
	EX DE, HL		; PUT IT BACK IN [DE]
	LD A, D		; SEE IF VALUE IS NEGATIVE
	RLA
	PUSH AF		; SAVE RESULTS OF TEST
	JR NC, DSCPOS
	DEC DE		; MAKE IT TRUNCATE DOWN
DSCPOS:
	HLFDE  ; DIVIDE BY FOUR
	HLFDE 
	POP AF		; SEE IF WAS NEGATIVE
	RET NC
; ALL DONE IF WAS POSITIVE
	LD A, D		; OR IN HIGH 2 BITS TO MAKE NEGATIVE
	OR 192D
	LD D, A
	INC DE		; ADJUST SO TRUNCATING TO LOWER VALUE
	RET
GOSCAL:
	LD A, D		; SEE IF NEGATIVE
	RLA
	JR NC, GOSC2		; NO, MULTIPLY AS-IS
	LD HL, OFFSET NEGD		; NEGATE BEFORE RETURNING
	PUSH HL
	NEGDE  ; MAKE POSITIVE FOR MULTIPLY
GOSC2:
	LD A, C		; GET SCALE FACTOR
	JP SCALE2		; DO THE SCALE
DCOLR:
	JR NC, NCFCER		; FC ERROR IF NO ARG
	LD A, E		; GO SET ATTRIBUTE
	CALL SETATR
	JP C, FCERR
; ERROR IF ILLEGAL ATTRIBUTE
	LD (ATRBYT), A		; Save as default
	RET
CHKRNG:
	PUSH HL		; SAVE TXTPTR
	CALL SCALXY
	JP NC, FCERR
; OUT OF BOUNDS - ERROR
CHKPHR:
	POP HL		; REGET TXTPTR
	RET
