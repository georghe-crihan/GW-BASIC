;  [ This translation created 10-Feb-83 by Version 4.3 ]
	.radix 8
;  To be safe
; CSEG CODESG (public)
; Assuming segment CS:CSEG
	include BINTRP.H

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; GWDATA copied from BINTRP.MAC ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

	.radix 10
	SLASHI=0
; Runtime Switch to include IBM Compat.-Features
	FETOK=0
; For FE extended tokens
	FDTOK=0
; For FD tokens too.  (Must have
; FETOK==1.)
; tokens.
	INTDEX=0
; For Intelledex version.
	NMPAGE=1
; Number of text pages (for GW
; Multi-page)
; KPOS, etc.
	LNREAD=0
; For LINE READ statement
	MELCO=0
; Mitsubishi Electronics Co.
	SIRIUS=0
	MCI=0
	ZENITH=0
; ZENITH 8086
	TETRA=0
	CPM86=0
	HAL=0
	GENFLS=0
	PANDBL=0
	TSHIBA=0
	SGS=0
	ALPS=0
	ALPCPM=0
	GENWID=0
	NNECBS=0
	CAN8=0
	PC8A=0
	FN2SW=0
; IBMTOK versions dispatch from IBMRES.MAC
	LABEL=PC8A
	HLPEDT=PC8A
	OKI=0
	BUBL=0
	NORNF=0
	IEESLV=0
	TRSHHC=0
	OLVPPC=0
	NECPPC=0
	USA=0
; For HHC-USA version
	EUROPE=0
; For HHC-EUROPE version
; Local Switches
; 
	LTRACE=ALPCPM
; trace output selectable
	LABEL=PC8A
	HLPEDT=PC8A
	UCEMSG=NNECBS
; Upper case error messages.
	OLD86=MELCO AND CPM86
; For "old" 8086 error messages (prior
; to alignment for IBM compatibility).
	OLDBLD=ALPCPM OR ALPS OR OKI OR HAL OR PC8A OR BUBL OR GW OR TSHIBA
	include GIO86U
	include MSDOSU
; MSDOS constants
	EXTERN _DVTBL:NEAR
	EXTERN _DVPTR:NEAR
	EXTERN _DVINI:NEAR
	EXTERN _DVTRM:NEAR
	EXTERN INIT:NEAR
	EXTERN INTDIV:NEAR
	EXTERN CONCON:NEAR
	EXTERN CONCN2:NEAR
	BUFOFS=0
	BUFOFS=2
; MUST CRUNCH INTO ERALIER PLACE FOR
;  SINGLE QUOTE
	KBFLEN=BUFLEN+(BUFLEN/4)
; MAKE KRUNCH BUFFER SOMEWHAT
;  LARGER THAN SOURCE BUFFER (BUF)
	EXTERN NAME:NEAR
	EXTERN INLIN:NEAR
	EXTERN CRDO:NEAR
