	include IBMRES.H

;;; Equates and External Declarations ;;;


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; IBMRES - IBM compatible reserved words / MLC ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; 
; 
; --------- --- ---- -- ---------
; COPYRIGHT (C) 1982 BY MICROSOFT
; --------- --- ---- -- ---------
; 
; This module is used to create GW-BASICs with IBM PC compatible
; reserved word tokens.  The reserved word tables were created by
; cleaning up a copy of the tables from BINTRP.  The code and tables
; to handle the extended reserved words was taken from L2RESS.MAC and
; modified as necessary.
; 	
	GWLEV2=0
; GW BASIC version 2.0 features
	.radix 10
	PUBLIC $KEY2B
	PUBLIC $COM2B
	PUBLIC $PEN2B
	PUBLIC $STR2B
	EXTERN CHRGTR:NEAR
	EXTERN DATEF:NEAR
	EXTERN LABBCK:NEAR
	EXTERN MAKUPL:NEAR
	EXTERN NOTRFN:NEAR
	EXTERN PARCHK:NEAR
	EXTERN PENS:NEAR
	EXTERN PLOOP2:NEAR
	EXTERN PPSWRT:NEAR
	EXTERN RENCRN:NEAR
	EXTERN STRIGS:NEAR
	EXTERN TIMEF:NEAR
	EXTERN TSTANM:NEAR
; CSEG DATASG (public)
; Assuming segment DS:DSEG
	EXTERN FLGOVC:WORD
	EXTERN TEMPA:WORD
; 
;  THESE MACRO CALLS DEFINE THE RESWRD VALUES
;  AND THE TABLE DISPATCH FOR STATEMENTS AND FUNCTIONS
; 
;  STATEMENTS:
; 
	PUBLIC STMDSP
STMDSP:
; MARKS START OF STATEMENT LIST
	QQ=128
	R2 END, ENDST
	R FOR
	R NEXT
	R2 DATA, DATAS
	R INPUT
	R DIM
	R READ
	R LET
	R GOTO
	R RUN
	R2 IF, IFS
	R RESTORE
	R GOSUB
	R RETURN
	R REM
	R STOP
	R PRINT
	R CLEAR
	R LIST
	R2 NEW, SCRATH
	R2 ON, ONGOTO
	R2 WAIT, FNWAIT
	R DEF
	R POKE
	R CONT
	R2 DUMMY, SNERR ; padding
	R2 DUMMY, SNERR ; padding
	R2 OUT, FNOUT
	R LPRINT
	R LLIST
	R2 DUMMY, SNERR ; padding
	R2 WIDTH, WIDTHS
	R2 ELSE, ELSES
	R2 TRON, TON
	R2 TROFF, TOFF
	R SWAP
	R ERASE
	R EDIT
	R2 ERROR, ERRORS
	R RESUME
	R DELETE
	R AUTO
	R2 RENUM, RESEQ
	R DEFSTR
	R DEFINT
	R2 DEFSNG, DEFREA
	R DEFDBL
	R LINE
	R WHILE
	R WEND
	R2 CALL, CALLS
	R2 DUMMY, SNERR ; padding
	R2 DUMMY, SNERR ; padding
	R2 DUMMY, SNERR ; padding
	R WRITE
	R OPTION
	R2 RANDOMIZE, RANDOM
	R OPEN
	R CLOSE
	R LOAD
	R MERGE
	R SAVE
	R COLOR
	R CLS
	R MOTOR
	R BSAVE
	R BLOAD
	R2 SOUND, SOUNDS
	R2 BEEP, BEEPS
	R PSET
	R PRESET
	R SCREEN
	R2 KEY, KEYS
	$KEY2B=0+QQ
; value of KEY 2-byte token
	R LOCATE
	PUBLIC NUMCMD
	NUMCMD=QQ-$END+1
; 
;  TOKENS
; 
; 
; QQ MUST BE SET SO TOKENS START AT RIGHT PLACE
; 
	QQ=QQ+1
	T TO
	T THEN
	PUBLIC THENTK
	THENTK=QQ
	T TAB
	PUBLIC TABTK
	TABTK=QQ
	T STEP
	PUBLIC STEPTK
	STEPTK=QQ
	T USR
	PUBLIC USRTK
	USRTK=QQ
	T FN
	PUBLIC FNTK
	FNTK=QQ
	T SPC
	PUBLIC SPCTK
	SPCTK=QQ
	T NOT
	PUBLIC NOTTK
	NOTTK=QQ
	T ERL
	PUBLIC ERLTK
	ERLTK=QQ
	T ERR
	PUBLIC ERCTK
	ERCTK=QQ
	T STRING$
	T USING
	PUBLIC USINTK
	USINTK=QQ
	T INSTR
	PUBLIC INSRTK
	INSRTK=QQ
	T DUMMY
	PUBLIC SNGQTK
	SNGQTK=QQ
	T VARPTR
	T CSRLIN
	PUBLIC CLINTK
	CLINTK=QQ
	T POINT
	T OFF
	T INKEY$
; 
;  OPERATORS
; 
	QQ=QQ+7
	T DUMMY
	PUBLIC GREATK
	GREATK=QQ
	T DUMMY
	PUBLIC EQULTK
	EQULTK=QQ
	T DUMMY
	PUBLIC LESSTK
	LESSTK=QQ
	T DUMMY
	PUBLIC PLUSTK
	PLUSTK=QQ
	T DUMMY
	PUBLIC MINUTK
	MINUTK=QQ
	T DUMMY
	PUBLIC MULTK
	MULTK=QQ
	T DUMMY
	PUBLIC DIVTK
	DIVTK=QQ
	T DUMMY
	PUBLIC EXPTK
	EXPTK=QQ
	T AND
	T OR
	T XOR
	T EQV
	T IMP
	T MOD
	T DUMMY
	PUBLIC IDIVTK
	IDIVTK=QQ
	PUBLIC LSTOPK
	LSTOPK=QQ+1-PLUSTK
; 
;  FUNCTIONS - 2 byte tokens, the 1st byte is FF
; 
	QQ=128
	PUBLIC FUNDSP
FUNDSP:
	R LEFT$
	PUBLIC ONEFUN
	ONEFUN=QQ
	R RIGHT$
	R MID$
	PUBLIC MIDTK
	MIDTK=QQ
	R SGN
	R2 INT, VINT
	R2 ABS, ABSFN
	R SQR
	PUBLIC SQRTK
	SQRTK=QQ
	R RND
	R SIN
	R LOG
	R EXP
	R COS
	R TAN
	R ATN
	PUBLIC ATNTK
	ATNTK=QQ
	R FRE
	R2 INP, FNINP
	R POS
	R LEN
	R STR$
	R VAL
	R ASC
	R CHR$
	R PEEK
	R SPACE$
	R2 OCT$, STRO$
	R2 HEX$, STRH$
	R LPOS
	PUBLIC LASNUM
	LASNUM=QQ
	R2 CINT, FRCINT
	R2 CSNG, FRCSNG
	R2 CDBL, FRCDBL
	R2 DUMMY, FIXER
	PUBLIC $FIX
	$FIX=QQ
	R2 PEN, PENF
	$PEN2B=0+(400O*377O)+QQ
; value of PEN 2-byte token
	R2 STICK, STICKF
	R2 STRIG, STRIGF
	$STR2B=0+(400O*377O)+QQ
; value of STRIG 2-byte token
	R EOF
	R LOC
	R LOF
; 
;  THE FOLLOWING TABLES ARE THE ALPHABETIC DISPATCH TABLE
;  FOLLOWED BY THE RESERVED WORD TABLE ITSELF
; 
	PUBLIC ALPTAB
ALPTAB:
	dw ('offset', 'ATAB')
	dw ('offset', 'BTAB')
	dw ('offset', 'CTAB')
	dw ('offset', 'DTAB')
	dw ('offset', 'ETAB')
	dw ('offset', 'FTAB')
	dw ('offset', 'GTAB')
	dw ('offset', 'HTAB')
	dw ('offset', 'ITAB')
	dw ('offset', 'JTAB')
	dw ('offset', 'KTAB')
	dw ('offset', 'LTAB')
	dw ('offset', 'MTAB')
	dw ('offset', 'NTAB')
	dw ('offset', 'OTAB')
	dw ('offset', 'PTAB')
	dw ('offset', 'QTAB')
	dw ('offset', 'RTAB')
	dw ('offset', 'STAB')
	dw ('offset', 'TTAB')
	dw ('offset', 'UTAB')
	dw ('offset', 'VTAB')
	dw ('offset', 'WTAB')
	dw ('offset', 'XTAB')
	dw ('offset', 'YTAB')
	dw ('offset', 'ZTAB')
	PUBLIC RESLST
RESLST:
ATAB:
	Q AUTO
	Q AND
	QF ABS
	QF ATN
	QF ASC
	DB 0D
BTAB:
	Q BSAVE
	Q BLOAD
	Q BEEP
	DB 0D
CTAB:
	Q COLOR
	Q CLOSE
	Q CONT
	Q CLEAR
	Q CSRLIN
	QF CINT
	QF CSNG
	QF CDBL
	QF COS
	QF CHR$
	Q CALL
	Q CLS
	DB 0D
DTAB:
	Q DELETE
	Q DATA
	Q DIM
	Q DEFSTR
	Q DEFINT
	Q DEFSNG
	Q DEFDBL
	Q DEF
	DB 0D
ETAB:
	Q ELSE
	Q END
	Q ERASE
	Q EDIT
	Q ERROR
	Q ERL
	Q ERR
	QF EXP
	QF EOF
	Q EQV
	DB 0D
FTAB:
	Q FOR
	Q FN
	QF FRE
	QF FIX
	DB 0D
GTAB:
	Q GOTO
	DB "O"
	DB " "
	DB "T"
	DB "O"+128D
	DB $GOTO
	Q GOSUB
	DB 0D
HTAB:
	QF HEX$
	DB 0D
ITAB:
	Q INPUT
	Q IF
	Q INSTR
	QF INT
	QF INP
	Q IMP
	Q INKEY$
	DB 0D
JTAB:
	DB 0D
KTAB:
	Q KEY
	DB 0D
LTAB:
	Q LOCATE
	Q LPRINT
	Q LLIST
	QF LPOS
	Q LET
	Q LINE
	Q LOAD
	Q LIST
	QF LOG
	QF LOC
	QF LEN
	QF LEFT$
	QF LOF
	DB 0D
MTAB:
	Q MOTOR
	Q MERGE
	Q MOD
	QF MID$
	DB 0D
NTAB:
	Q NEXT
	Q NEW
	Q NOT
	DB 0D
OTAB:
	Q OPEN
	Q OUT
	Q ON
	Q OR
	QF OCT$
	Q OPTION
	Q OFF
	DB 0D
PTAB:
	Q PRINT
	Q POKE
	QF POS
	QF PEEK
	Q PSET
	Q PRESET
	Q POINT
	QF PEN
	DB 0D
QTAB:
	DB 0D
RTAB:
	Q RUN
	Q RETURN
	Q READ
	Q RESTORE
	Q REM
	Q RESUME
	QF RIGHT$
	QF RND
	Q RENUM
	Q RANDOMIZE
	DB 0D
STAB:
	Q SCREEN
	Q STOP
	Q SWAP
	Q SAVE
	DB "P"
	DB "C"
	DB "("+128D
	DB SPCTK
	Q STEP
	QF SGN
	QF SQR
	QF SIN
	QF STR$
	Q STRING$
	QF SPACE$
	Q SOUND
	QF STICK
	QF STRIG
	DB 0D
TTAB:
	Q THEN
	Q TRON
	Q TROFF
	DB "A"
	DB "B"
	DB "("+128D
	DB TABTK
	Q TO
	QF TAN
	DB 0D
UTAB:
	Q USING
	Q USR
	DB 0D
VTAB:
	QF VAL
	Q VARPTR
	DB 0D
WTAB:
	Q WIDTH
	Q WAIT
	Q WHILE
	Q WEND
	Q WRITE
	DB 0D
XTAB:
	Q XOR
	DB 0D
YTAB:
	DB 0D
ZTAB:
	DB 0D
	PUBLIC SPCTAB
SPCTAB:
	DB "+"+128D
	DB PLUSTK
	DB "-"+128D
	DB MINUTK
	DB "*"+128D
	DB MULTK
	DB "/"+128D
	DB DIVTK
	DB "^"+128D
	DB EXPTK
	DB "\"+128D
	DB IDIVTK
	DB "'"+128D
	DB SNGQTK
	DB 62+128D
	DB GREATK
	DB "="+128D
	DB EQULTK
	DB 60+128D
	DB LESSTK
	DB 0D

;;; Extended reserved words ;;;

; The following are 2 byte tokens, the 1st byte is FE
	QQ=128D
STMDSX:
	R FILES
	R FIELD
	R SYSTEM
	R NAME
	R LSET
	R RSET
	R KILL
	R PUT
	R GET
	R RESET
	R COMMON
	R CHAIN
	R2 DATE$, DATES
	R2 TIME$, TIMES
	R PAINT
	R2 COM, COMS
	$COM2B=0+(400O*376O)+QQ
; value of COM 2-byte token
	R CIRCLE
	R DRAW
	R2 PLAY, PLAYS
	R TIMER
	R ERDEV
	R IOCTL
	R CHDIR
	R MKDIR
	R RMDIR
	R SHELL
	R ENVIRON
	R VIEW
	R WINDOW
	R PMAP
	R2 PALETTE, PALETE
	R2 LCOPY, LCOPYS
	R2 CALLS, CALLSL
; *************************************************************************
; *** The DEBUG entry should be the last entry in the FE Dispatch table ***
; *************************************************************************
; The following are 2 byte tokens, the 1st byte is FD
	QQ=128D
FUNDSX:
	R CVI
	R CVS
	R CVD
	R MKI$
	R MKS$
	R MKD$
	R2 KTN, KTNFN
	R2 JIS, JISFN
	R2 KPOS, KPOSFN
	R2 KLEN, KLENFN
	PUBLIC ALPTAX
ALPTAX:
	ADR ATABX
	ADR BTABX
	ADR CTABX
	ADR DTABX
	ADR ETABX
	ADR FTABX
	ADR GTABX
	ADR HTABX
	ADR ITABX
	ADR JTABX
	ADR KTABX
	ADR LTABX
	ADR MTABX
	ADR NTABX
	ADR OTABX
	ADR PTABX
	ADR QTABX
	ADR RTABX
	ADR STABX
	ADR TTABX
	ADR UTABX
	ADR VTABX
	ADR WTABX
	ADR XTABX
	ADR YTABX
	ADR ZTABX
RESLSX:
ATABX:
	DB 0D
BTABX:
	DB 0D
CTABX:
	Q CHAIN
	QF CVI
	QF CVS
	QF CVD
	Q COMMON
	Q COM
	Q CIRCLE
	Q CALLS
	DB 0D
DTABX:
	Q DATE$
	Q DRAW
	DB 0D
ETABX:
	DB 0D
FTABX:
	Q FIELD
	Q FILES
	DB 0D
GTABX:
	Q GET
	DB 0D
HTABX:
	DB 0D
ITABX:
	Q IOCTL
	DB 0D
JTABX:
	DB 0D
KTABX:
	Q KILL
	DB 0D
LTABX:
	Q LSET
	Q LCOPY
	DB 0D
MTABX:
	QF MKI$
	QF MKS$
	QF MKD$
	DB 0D
NTABX:
	Q NAME
	DB 0D
OTABX:
	DB 0D
PTABX:
	Q PUT
	Q PAINT
	Q PLAY
	DB 0D
QTABX:
	DB 0D
RTABX:
	Q RSET
	Q RESET
	DB 0D
STABX:
	Q SYSTEM
	DB 0D
TTABX:
	Q TIME$
	DB 0D
UTABX:
	DB 0D
VTABX:
	DB 0D
WTABX:
	DB 0D
XTABX:
	DB 0D
YTABX:
	DB 0D
ZTABX:
	DB 0D
	PUBLIC NUMGFN
	PUBLIC BOTCON
	PUBLIC TOPCON
	PUBLIC $RNDFN
	PUBLIC $DATCO
	PUBLIC $REMCO
	PUBLIC NMREL
	PUBLIC $CHRFN
	PUBLIC $CSNGF
	PUBLIC $CDBLF
	NUMGFN=(2*MIDTK)-(2*ONEFUN)+1
	BOTCON=(SQRTK-ONEFUN)*2
	TOPCON=(ATNTK-ONEFUN)*2+1
	$RNDFN=$RND-ONEFUN
	$DATCO=$DATA-":"
	$REMCO=$REM-":"
	NMREL=LESSTK-GREATK+1
	$CHRFN=$CHR$-ONEFUN
	$CSNGF=$CSNG-ONEFUN
	$CDBLF=$CDBL-ONEFUN

;;; CRUNCH code to handle extended reserved words ;;;

	PUBLIC CRUNCX
CRUNCX:
	POP HL		; GET BACK SOURCE POINTER
	PUSH HL		; TO TRY AGAIN
	DEC HL		; POINT AT CHARACTER
	CALL MAKUPL		; CONVERT TO UPPER CASE
	LD HL, OFFSET ALPTAX		; GET POINTER TO ALPHA DISPATCH TABLE
	SUB "A"		; SUBTRACT ALPHA OFFSET
	RLA		; MULTIPLY BY TWO
	LD C, A		; SAVE OFFSET IN [C] FOR DAD.
	LD B, LOW 0		; MAKE HIGH PART OF OFFSET ZERO
	ADD HL, BC		; ADD TO TABLE ADDRESS
	LD DE, (HL)		; GET POINTER IN [D,E]
	POP HL		; GET BACK SOURCE POINTER
TRYAGA:
	PUSH HL		; SAVE TXTPTR TO START OF SEARCH AREA
LOPPSI:
	CALL MAKUPL		; TRANSLATE THIS CHAR TO UPPER CASE
	LD C, A		; SAVE CHAR IN [C]
	LD IYH, D
	LD IYL, E		; FETCH FROM CODE SEGMENT
	; LODSB {'type': 'instruction', 'op': 'lodsb', 'operands': ('AL', '[SI]'), 'comment': None, 'id': 726}
	AND LOW 127		; GET RID OF HIGH BIT
	JP Z, NOTRFN
; IF=0 THEN END OF THIS CHARS RESLT
	INC HL		; BUMP SOURCE POINTER
	CP C		; COMPARE TO CHAR FROM SOURCE LINE
	JR NZ, LOPSKP		; IF NO MATCH, SEARCH FOR NEXT RESWRD
	LD IYH, D
	LD IYL, E		; FETCH FROM CODE SEGMENT
	; LODSB {'type': 'instruction', 'op': 'lodsb', 'operands': ('AL', '[SI]'), 'comment': None, 'id': 735}
	INC DE		; BUMP RESLST POINTER
	OR A		; SET CC'S
	JP P, LOPPSI
; SEE IF REST OF CHARS MATCH
	LD IYH, D
	LD IYL, E		; FETCH FROM CODE SEGMENT
	; LODSB {'type': 'instruction', 'op': 'lodsb', 'operands': ('AL', '[SI]'), 'comment': None, 'id': 742}
	CALL MAKUPL		; GET NEXT CHAR IN LINE (MC 6/22/80)
	CP "."		; IS IT A DOT
	JR Z, ISVARS		; YES
	CALL TSTANM		; IS IT A LETTER IMMEDIATELY
; FOLLOWING RESWRD
ISVARS:
	LD A, LOW 0		; SET DONUM TO -1
	JP NC, NOTRFN
; IF ALPHA, CANT BE RESERVED WORD
	POP AF		; GET RID OF SAVED [H,L]
	LD IYH, D
	LD IYL, E		; FETCH FROM CODE SEGMENT
	; LODSB {'type': 'instruction', 'op': 'lodsb', 'operands': ('AL', '[SI]'), 'comment': None, 'id': 755}
	OR A		; SET CC'S
	POP BC		; GET CHAR COUNT OFF STACK
	POP DE		; GET DEPOSIT POINTER OFF STACK
	JP M, NOTFNT
; IF MINUS, WASNT FUNCTION TOKEN
	OR 128D		; MAKE HIGH ORDER BIT ONE
	SCF		; AND FORCE LEADER BYTE TO BE 375
NOTFNT:
	PUSH AF		; SAVE FN CHAR
	LD A, LOW 254		; GET BYTE WHICH PRECEEDS FNS
	SBC 0		; MAKE FUNCTION LEADER 375
	JP RENCRN		; REENTER CRUNCH WITH NEW RESERVED WORD
LOPSKP:
	POP HL		; RESTORE UNDEFILED TEXT POINTER
LOPSK2:
	LD IYH, D
	LD IYL, E		; FETCH FROM CODE SEGMENT
	; LODSB {'type': 'instruction', 'op': 'lodsb', 'operands': ('AL', '[SI]'), 'comment': None, 'id': 773}
	INC DE		; BUMP RESLST POINTER
	OR A		; SET CC'S
	JP P, LOPSK2
; NOT END OF RESWRD, KEEP SKIPPING
	INC DE		; POINT AFTER TOKEN
	JP TRYAGA		; TRY ANOTHER RESWRD

;;; LIST code for extended reserved words ;;;

BUFRET:
	RET
NEWFUN:
	LD A, (HL)		; GET FUNCTION NUMBER
	AND LOW 127		; TAKE OFF HIGH BIT
	JR BUFCON
	PUBLIC LISTX
LISTX:
	CP 253		; IS IT A NEW FUNCTION
	JR Z, NEWFUN
	CP 254		; IS IT A NEW STATEMENT
	JR NZ, BUFRET		; NO, JUST CONTINUE NORMAL PATH
	LD A, (HL)		; GET NUMBER OF STATEMENT
BUFCON:
	POP HL		; Get rid of the return address.
	LD HL, OFFSET RESLSX -1		; GET PTR TO START OF RESERVED WORD LIST
	LD B, A		; SAVE THIS CHAR IN [B]
	LD C, LOW OFFSET "A" -1		; INIT LEADING CHAR VALUE
RESSR3:
	INC C		; BUMP LEADING CHAR VALUE.
RESSR1:
	INC HL		; BUMP POINTER INTO RESLST
RESSRC:
	LD D, H		; SAVE PTR TO START OF THIS RESWRD
	LD E, L
RESSR2:
; FETCH FROM CODE SEGMENT
	LD A, (HL)		; GET CHAR FROM RESLST
	OR A		; SET CC'S
	JR Z, RESSR3		; IF END OF THIS CHARS TABLE,
; GO BACK & BUMP C
	INC HL
; BUMP SOURCE PTR
	JP P, RESSR2
; IF NOT END OF THIS RESWRD,
; THEN KEEP LOOKING
; FETCH FROM CODE SEGMENT
	LD A, (HL)		; GET PTR TO RESERVED WORD VALUE
	CP B		; SAME AS THE ONE WE SEARCH FOR?
	JR NZ, RESSR1		; NO, KEEP LOOKING.
	EX DE, HL		; SAVE FOUND PTR IN [H,L]
	LD A, C		; GET LEADING CHAR
	POP DE		; RESTORE LINE CHAR COUNT
	POP BC		; RESTORE DEPOSIT PTR
	LD E, A		; SAVE LEADING CHAR IN [E]
; 
;  CODE BELOW NOT NEEDED SINCE NO SPECIAL REVERVED WORDS IN HOOK TABLE
; 
;        CPI     "Z"+1           ;WAS IT A SPECIAL CHAR?
;        JRNZ    NTSPCH          ;NON-SPECIAL CHAR
;        XRA     A               ;SET NON-SPECIAL
;        STA     TEMPA
;        JMPR    MORPUR          ;PRINT IT
NTSPCH:
	LD A, (TEMPA)		; WHAT DID WE DO LAST?
	OR A		; SPECIAL?
	LD A, LOW 255		; FLAG IN RESERVED WORD
	LD (TEMPA), A		; CLEAR FLAG
MORLNZ:
	JR Z, MORLN0		; GET CHAR AND PROCEED
	LD A, LOW " "		; PUT SPACE IN BUFFER
	LD IXH, B
	LD IXL, C
	LD (IX), A
	INC BC
	DEC D		; ANY SPACE LEFT IN BUFFER
	JP Z, PPSWRT
; NO, RETURN
MORLN0:
	LD A, E
	JR MORLN1		; CONTINUE
MORPUR:
; FETCH FROM CODE SEGMENT
	LD A, (HL)		; GET BYTE FROM RESWRD
	INC HL		; BUMP POINTER
MORLNP:
	LD E, A		; SAVE CHAR
MORLN1:
	AND LOW 127		; AND OFF HIGH ORDER BIT FOR DISK & EDIT
	LD IXH, B
	LD IXL, C
	LD (IX), A		; STORE THIS CHAR
	INC BC		; BUMP PTR
	DEC D		; BUMP DOWN REMAINING CHAR COUNT
	JP Z, PPSWRT
; IF END OF LINE, JUST RETURN
	OR E		; SET CC'S
	JP P, MORPUR
; END OF RESWRD?
	POP HL		; RESTORE SOURCE PTR.
	INC HL		; SKIP OVER RESERVED WORD
	JP PLOOP2		; GET NEXT CHAR FROM LINE

;;; Extended Statement Dispatching ;;;

SNERRS:
	JP SNERR
	PUBLIC NEWSTX
NEWSTX:
	CP 254-201		; CHECK FOR NEW STATEMENT PREFIX
	JR Z, GONE4		; IF SO, DISPATCH
	CP 255-201		; FUNCTION?
	JR NZ, GIIRET
	POP BC		; Put return address into B.
	INC HL
	LD A, (HL)
	CP $PEN		;  PEN as stmt?
	JP Z, PENV
;  Brif so.
	CP $STRIG		; STRIG as stmt?
	JP Z, STRIGV
;  Brif so.
	DEC HL
	LD A, LOW OFFSET 255 -201
	PUSH BC		; Put the return address back on.
GIIRET:
	RET		; MID$ OR SYNTAX ERROR
PENV:
	CALL CHRGTR
	JP PENS
STRIGV:
	CALL CHRGTR
	JP STRIGS
GONE4:
	POP BC		; Get rid of the return address.
	INC HL		; LOOK AT NEXT CHAR
	LD A, (HL)		; FETCH IT
	SUB 129		; GET RELATIVE POSITION IN STMDSX
	JR C, SNERRS		; IF TOO SMALL, SYNTAX ERROR
	RLA		; TURN BYTE INTO OFFSET
	; FIXME: This is invalid Z80 code
	PUSH AF
	XOR A
	LD B', 0
	POP AF		; XOR AH,AH
	LD IYH, A
	LD IYL, X		; MOV SI,AX - GET OFFSET INTO [SI]
; CODE SEGMENT OVERRIDE
	PUSH HL
	LD HL, (STMDSX)
	EX (SP), HL		; PUSH STMDSP(SI) - PUSH ADDRESS
	JP CHRGTR		; START STATEMENT

;;; EVAL code for extended functions ;;;

	PUBLIC EVALX
EVALX:
	CP 254
	JR Z, EVALNS		; Brif possible stmt as function
	CP 253
	JR Z, EVALNF		; NEW FUNCTION IF 375 IN FRONT
	RET
EVALNS:
	INC HL
	LD A, (HL)
	CP $DATE$
	JR Z, DATEV		; Brif DATE$
	CP $TIME$
	JR Z, TIMEV		; Brif TIME$
	DEC HL
	LD A, (HL)
	RET
DATEV:
	POP BC		; Get rid of the hook return address.
	JP DATEF		; Do DATE function.
TIMEV:
	POP BC		; Get rid of the hook return address.
	JP TIMEF		; Do TIME$ function.
EVALNF:
	POP BC		; Get rid of the return address.
	INC HL
	LD A, (HL)
	SUB 129
	LD B, LOW 0
	RLA
	LD C, A
	PUSH BC
	CALL CHRGTR
	CALL PARCHK
	EX (SP), HL		; XTHL
	LD DE, OFFSET LABBCK
	PUSH DE
	LD A, LOW 1
	LD (FLGOVC), A
	LD IYH, H
	LD IYL, L		; MOV SI,BX (GET FUNCTION OFFSET IN SI)
	PUSH HL
	LD HL, (FUNDSX)
	EX (SP), HL
	RET
