;  [ This translation created 10-Feb-83 by Version 4.3 ]
	.radix 8
;  To be safe
; CSEG CODESG (public)
; Assuming segment CS:CSEG
	include OEM.H

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; MACLNG - MACRO LANGUAGE DRIVER ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; 
;  MICROSOFT GRAPHICS AND SOUND MACRO LANGUAGES
; 
	TSHIBA=0
	ALPCPM=0
	PUBLIC FETCHR
	PUBLIC FETCHZ
	PUBLIC DECFET
	PUBLIC VALSCN
	PUBLIC VALSC2
	PUBLIC VARGET
	PUBLIC NEGD
	EXTERN FCERR:NEAR
	EXTERN FRESTR:NEAR
	EXTERN FRCINT:NEAR
	EXTERN FRMEVL:NEAR
	EXTERN ISVAR:NEAR
; CSEG DATASG (public)
; Assuming segment DS:DSEG
	EXTERN MCLLEN:WORD
	EXTERN MCLPTR:WORD
	EXTERN BUF:WORD
	EXTERN MCLTAB:WORD
	PUBLIC MACLNG
	PUBLIC MCLXEQ
	EXTERN GETBCD:NEAR
MACLNG:
	LD (MCLTAB), DE		; SAVE POINTER TO COMMAND TABLE
	CALL FRMEVL		; EVALUATE STRING ARGUMENT
	PUSH HL		; SAVE TXTPTR TILL DONE
	LD DE, 0		; PUSH DUMMY ENTRY TO MARK END OF STK
	PUSH DE		; DUMMY ADDR
	PUSH AF		; DUMMY LENGTH
MCLNEW:
	CALL FRESTR
	CALL GETBCD		; GET LENGTH & POINTER
	LD A, B
	OR C
	JR Z, MCLOOP		; Don't Push if addr is 0
	LD A, D
	OR A
	JR Z, MCLOOP		;  or if Len is 0...
	PUSH BC		; PUSH ADDR OF STRING
	LD A, D		; PUT IN [AL]
	PUSH AF
MCLOOP:
	POP AF		; GET LENGTH OFF STACK
	LD (MCLLEN), A
	POP HL		; GET ADDR
	OR A		; SEE IF LAST ENTRY
	JP Z, POPTRT
; ALL FINISHED IF ZERO
	LD (MCLPTR), HL		; SET UP POINTER
MCLSCN:
	CALL FETCHR		; GET A CHAR FROM STRING
	JR Z, MCLOOP		; END OF STRING - SEE IF MORE ON STK
	RLA		; PUT CHAR * 2 INTO [C]
	LD C, A
	LD HL, (MCLTAB)		; POINT TO COMMAND TABLE
MSCNLP:
; CS OVERRIDE
	LD A, (HL)		; GET CHAR FROM COMMAND TABLE
	RLA		; CHAR = CHAR * 2 (CLR HI BIT FOR CMP)
GOFCER:
	CALL Z, FCERR
; END OF TABLE.
	CP C		; HAVE WE GOT IT?
	JR Z, MISCMD		; YES.
	INC HL		; MOVE TO NEXT ENTRY
	INC HL
	INC HL
	JR MSCNLP
MISCMD:
	LD BC, OFFSET MCLSCN		; RETURN TO TOP OF LOOP WHEN DONE
	PUSH BC
; CS OVERRIDE
	LD A, (HL)		; SEE IF A VALUE NEEDED
	LD C, A		; PASS GOTTEN CHAR IN [C]
	RLA
	JR NC, MNOARG		; COMMAND DOESN'T REQUIRE ARGUMENT
	OR A		; CLEAR CARRY
	RRCA		; MAKE IT A CHAR AGAIN
	LD C, A		; PUT IN [C]
	PUSH BC
	PUSH HL		; SAVE PTR INTO CMD TABLE
	CALL FETCHR		; GET A CHAR
	LD DE, 1		; DEFAULT ARG=1
	JP Z, VSNAR0
; NO ARG IF END OF STRING
	CALL ISLET2		; SEE IF POSSIBLE LETTER
	JP NC, VSNARG
	CALL VALSC3		; GET THE VALUE
	SCF		; SET CARRY TO FLAG USING NON-DEFAULT
	JR ISCMD3
VSNARG:
	CALL DECFET		; PUT CHAR BACK INTO STRING
VSNAR0:
	OR A		; CLEAR CARRY
ISCMD3:
	POP HL
	POP BC		; GET BACK COMMAND CHAR
MNOARG:
	INC HL		; POINT TO DISPATCH ADDR
; CS OVERRIDE
	LD HL, (HL)		; GET ADDRESS INTO HL
	JP BX		; DISPATCH
FETCHZ:
	CALL FETCHR		; GET A CHAR FROM STRING
	JR Z, GOFCER		; GIVE ERROR IF END OF LINE
	RET
FETCHR:
	PUSH HL
FETCH2:
	LD HL, (MCLLEN)		; POINT TO STRING LENGTH
	LD A, (HL)
	OR A
	JR Z, POPTRT		; RETURN Z=0 IF END OF STRING
	DEC (HL)		; UPDATE COUNT FOR NEXT TIME
	LD HL, (MCLPTR)		; GET PTR TO STRING
	LD A, (HL)		; GET CHARACTER FROM STRING
	INC HL		; UPDATE PTR FOR NEXT TIME
	LD (MCLPTR), HL
	CP " "		; SKIP SPACES
	JR Z, FETCH2
	CP 96		; CONVERT LOWER CASE TO UPPER
	JR C, POPTRT
	SUB 32		; DO CONVERSION
POPTRT:
	POP HL
	RET
DECFET:
	PUSH HL
	LD HL, (MCLLEN)		; INCREMENT LENGTH
	INC (HL)
	LD HL, (MCLPTR)		; BACK UP POINTER
	DEC HL
	LD (MCLPTR), HL
	POP HL
	RET
VALSCN:
	CALL FETCHZ		; GET FIRST CHAR OF ARGUMENT
VALSC3:
	CP "="		; NUMERIC?
	JP Z, VARGET
	CP "+"		; PLUS SIGN?
	JR Z, VALSCN		; THEN SKIP IT
	CP "-"		; NEGATIVE VALUE?
	JR NZ, VALSC2
	LD DE, OFFSET NEGD		; IF SO, NEGATE BEFORE RETURNING
	PUSH DE
	JR VALSCN		; EAT THE "-"
VALSC2:
	LD DE, 0		; INITIAL VALUE OF ZERO
NUMLOP:
	CP 44		; COMMA
	JR Z, DECFET		; YES, BACK UP AND RETURN
	CP 59		; SEMICOLON?
	RET Z
; YES, JUST RETURN
	CP "9"+1		; NOW SEE IF ITS A DIGIT
	JR NC, DECFET		; IF NOT, BACK UP AND RETURN
	CP "0"
	JR C, DECFET
	LD HL, 0		; [HL] is accumulator
	LD B, LOW 10		; [HL]=[DE]*10
NUML01:
	ADD HL, DE
	JR C, SCNFC		; overflow - JMP Function Call Error
	DJNZ NUML01
	SUB "0"		; ADD IN THE DIGIT
	LD E, A
	LD D, LOW 0
	ADD HL, DE
	JR C, SCNFC		; overflow - JMP Function Call Error
	EX DE, HL		; VALUE SHOULD BE IN [DE]
	CALL FETCHR		; GET NEXT CHAR
	JR NZ, NUMLOP		; branch if not end of string
	RET
SCNVAR:
; CSEG DATASG (public)
	EXTERN VALTYP:WORD
	EXTERN RETVAR:NEAR
; Allow VARPTR$(variable) for BASCOM compatibility
; 
	LD HL, (MCLPTR)		; Get string pntr
	LD A, (HL)		; possible VALTYP if string created by VARPTR$
	CP 9		; If .gt. 8 then not VARPTR$ string
	JR NC, SCNVR2		; Brif not VARPTR$ candidate
	LD A, (MCLLEN)		; Get str len
	SUB 3		; at least 3 bytes if it was created by VARPTR$
	JR C, SCNVR2		; else let SCNVAR generate FCERR for bad var name
	LD (MCLLEN), A		; len -3
	LD A, (HL)		; assume Byte 1 is Type
	LD (VALTYP), A		; so store in FAC
	INC HL
	LD E, (HL)
	INC HL
	LD D, (HL)		; [DE] = Var address.
	INC HL
	LD (MCLPTR), HL		; New pntr
	JP RETVAR		; Go return value in FAC
SCNVR2:
	CALL FETCHZ		; MAKE SURE FIRST CHAR IS LETTER
	LD DE, (BUF)		; PLACE TO COPY NAME FOR PTRGET
	PUSH DE		; SAVE ADDR OF BUF FOR "ISVAR"
	LD B, LOW 40		; COPY MAX OF 40 CHARACTERS
	CALL ISLET2		; MAKE SURE IT'S A LETTER
	JR C, SCNFC		; FC ERROR IF NOT LETTER
SCNVLP:
	LD IXH, D
	LD IXL, E
	LD (IX), A		; STORE CHAR IN BUF
	INC DE
	CP 59		; A SEMICOLON?
	JR Z, SCNV2		; YES - END OF VARIABLE NAME
	CALL FETCHZ		; GET NEXT CHAR
	DJNZ SCNVLP
SCNFC:
	CALL FCERR		; ERROR - VARIABLE TOO LONG
SCNV2:
	POP HL		; GET PTR TO BUF
	JP ISVAR		; GO GET ITS VALUE
VARGET:
	CALL SCNVAR		; SCAN & EVALUATE VARIABLE
	CALL FRCINT		; MAKE IT AN INTEGER
	EX DE, HL		; IN [DE]
	RET
	EXTERN GETSTK:NEAR
MCLXEQ:
	CALL SCNVAR		; SCAN VARIABLE NAME
	LD A, (MCLLEN)		; SAVE CURRENT STRING POS & LENGTH
	LD HL, (MCLPTR)
	EX (SP), HL		; XTHL
; POP OFF RET ADDR, PUSH MCLPTR
	PUSH AF
	LD C, LOW 2		; MAKE SURE OF ROOM ON STACK
	CALL GETSTK
	JP MCLNEW
NEGD:
	EX AF, AF'
	XOR A
	SUB E
	LD E, A
	SBC A, A
	SUB D
	LD D, A
	EX AF, AF'		; NEG DX,DX
	RET
ISLET2:
	CP "A"
	JR C, ISLETX		; TOO SMALL FOR LETTER
	CP "Z"+1
	CCF		; SET CARRY IF NOT LETTER
ISLETX:
	RET
